<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_oil_expense_tree" model="ir.ui.view">
      <field name="name">oil.expense.tree</field>
      <field name="model">oil.expense</field>
      <field name="arch" type="xml">
          <tree>
            <field name="name"/>
            <field name="amount"/>
            <field name="shift_id"/>
            <field name="user_id"/>
            <field name="date"/>
          </tree>
      </field>
    </record>

    <record id="view_oil_expense_form" model="ir.ui.view">
      <field name="name">oil.expense.form</field>
      <field name="model">oil.expense</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="amount"/>
              <field name="shift_id"/>
              <field name="user_id"/>
              <field name="date"/>
            </group>
            <group>
              <field name="note"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
  
    <record id="action_oil_expense_tree" model="ir.actions.act_window">
      <field name="name">Expenses</field>
      <field name="res_model">oil.expense</field>
      <field name="view_mode">tree,form</field>
      <field name="view_id" ref="view_oil_expense_tree" />

    </record>
    
    <!-- <menuitem id="menu_oil_expenses" name="Expenses" parent="menu_oil_shift_operations" action="action_oil_expense_tree"/> -->

</odoo>
