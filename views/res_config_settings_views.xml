<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_soft_restrict" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.soft.restrict</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Soft Restrict" string="Soft Restrict" name="soft_restrict" groups="base.group_system">
                    <block title="Soft Restrict Access">
                        <setting string="Enable Soft Restrict Access" help="Allow denied records to be opened only when linked to a document the user can already read.">
                            <field name="soft_restrict_enabled"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
