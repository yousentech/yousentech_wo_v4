<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_technician_commission_ratio" model="ir.ui.view">
        <field name="name">hr.employee.form.technician.commission.ratio</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_email']" position="after">
                <field name="is_wof_technician" widget="boolean_toggle"/>
                <field name="is_wof_supervisor" widget="boolean_toggle"/>
                <field name="technician_commission_ratio"
                       groups="yousentech_wo_v4.group_wo_manager"
                       invisible="not is_wof_technician"
                       help="تستخدم عند اختيار توزيع عمولة المكوّن حسب نسبة الفني."/>
            </xpath>
        </field>
    </record>

    <record id="view_employee_filter_wof_technician" model="ir.ui.view">
        <field name="name">hr.employee.search.wof.technician</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_team']" position="before">
                <filter name="wof_team" string="فريق التركيب" domain="['|', ('is_wof_technician', '=', True), ('is_wof_supervisor', '=', True)]"/>
                <filter name="wof_technicians" string="فنيو التركيب" domain="[('is_wof_technician', '=', True)]"/>
                <filter name="wof_supervisors" string="مشرفو التشغيل" domain="[('is_wof_supervisor', '=', True)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <record id="view_employee_tree_wof_technician" model="ir.ui.view">
        <field name="name">hr.employee.tree.wof.technician</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="is_wof_technician" widget="boolean_toggle"/>
                <field name="is_wof_supervisor" widget="boolean_toggle"/>
                <field name="technician_commission_ratio" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="action_wof_technicians" model="ir.actions.act_window">
        <field name="name">فريق التركيب: الفنيون ومشرفو التشغيل</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_employee_tree_wof_technician"/>
        <field name="search_view_id" ref="hr.view_employee_filter"/>
        <field name="context">{'search_default_wof_team': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">لا يوجد فريق تركيب بعد</p>
            <p>أزل فلتر «فريق التركيب» ثم فعّل «فني تركيب» أو «مشرف تشغيل» للموظفين. يظهر كل منهم في أوامر تركيب فرعه.</p>
        </field>
    </record>

    <menuitem id="menu_wof_technicians"
              name="فريق التركيب"
              parent="yousentech_wo_v4.menu_wo_v4_configuration"
              action="action_wof_technicians"
              groups="yousentech_wo_v4.group_wo_settings"
              sequence="72"/>
</odoo>
