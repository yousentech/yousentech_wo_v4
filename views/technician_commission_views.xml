<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Technician commissions: read-only follow-up and review. -->
    <record id="view_wof_technician_commission_tree" model="ir.ui.view">
        <field name="name">wof.technician.commission.tree</field>
        <field name="model">wof.technician.commission</field>
        <field name="arch" type="xml">
            <tree string="عمولات الفنيين" create="0" edit="0" delete="0"
                  decoration-muted="state in ('cancelled', 'replaced')"
                  decoration-danger="amount &lt; 0 and state not in ('cancelled', 'replaced')"
                  decoration-info="state == 'pending'">
                <field name="name"/>
                <field name="approved_at" optional="show"/>
                <field name="employee_id"/>
                <field name="order_id"/>
                <field name="vehicle_plate" optional="show"/>
                <field name="film_category_id" optional="show"/>
                <field name="car_part_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="entry_type" widget="badge" decoration-warning="entry_type == 'reversal'" decoration-info="entry_type == 'adjustment'"/>
                <field name="distribution" optional="hide"/>
                <field name="service_commission" optional="hide" sum="0"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="الإجمالي"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'" decoration-success="state == 'approved'"
                       decoration-primary="state == 'paid'" decoration-muted="state in ('cancelled', 'replaced')"/>
                <field name="source" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_wof_technician_commission_form" model="ir.ui.view">
        <field name="name">wof.technician.commission.form</field>
        <field name="model">wof.technician.commission</field>
        <field name="arch" type="xml">
            <form string="عمولة فني" create="0" edit="0" delete="0">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_order" type="object" class="oe_stat_button" icon="fa-car"
                                invisible="not order_id" string="أمر التركيب"/>
                    </div>
                    <widget name="web_ribbon" title="ملغاة" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>
                    <widget name="web_ribbon" title="مستبدلة" bg_color="text-bg-secondary" invisible="state != 'replaced'"/>
                    <div class="oe_title">
                        <span class="text-muted"><field name="entry_type" readonly="1"/></span>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <field name="line_id" invisible="1"/>
                    <group>
                        <group string="الفني والخدمة">
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="order_id"/>
                            <field name="vehicle_plate"/>
                            <field name="film_category_id" invisible="not film_category_id"/>
                            <field name="car_part_id" invisible="not car_part_id"/>
                        </group>
                        <group string="الحساب">
                            <field name="service_commission" invisible="entry_type == 'adjustment' and not line_id"/>
                            <field name="distribution"/>
                            <field name="weight" invisible="distribution != 'by_technician_ratio'"/>
                            <field name="amount" class="fw-bold fs-5"/>
                            <field name="commission_event" invisible="not commission_event"/>
                        </group>
                        <group string="الاعتماد والمصدر">
                            <field name="approved_at"/>
                            <field name="approved_by_id"/>
                            <field name="source"/>
                            <field name="reason" invisible="not reason"/>
                        </group>
                        <group string="الارتباطات" invisible="not reversed_entry_id and not refund_move_id and not reversal_ids">
                            <field name="reversed_entry_id" invisible="not reversed_entry_id"/>
                            <field name="refund_move_id" invisible="not refund_move_id"/>
                            <field name="reversal_ids" widget="many2many_tags" invisible="not reversal_ids"/>
                        </group>
                    </group>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" invisible="1"/>
                        <field name="message_ids"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wof_technician_commission_search" model="ir.ui.view">
        <field name="name">wof.technician.commission.search</field>
        <field name="model">wof.technician.commission</field>
        <field name="arch" type="xml">
            <search string="العمولات">
                <field name="employee_id"/>
                <field name="order_id"/>
                <field name="vehicle_plate"/>
                <field name="name"/>
                <field name="film_category_id"/>
                <filter name="live" string="السارية" domain="[('state', 'in', ('pending', 'approved', 'paid'))]"/>
                <separator/>
                <filter name="pending" string="معلّقة" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="معتمدة (غير مدفوعة)" domain="[('state', '=', 'approved')]"/>
                <filter name="paid" string="مدفوعة" domain="[('state', '=', 'paid')]"/>
                <filter name="closed" string="ملغاة أو مستبدلة" domain="[('state', 'in', ('cancelled', 'replaced'))]"/>
                <separator/>
                <filter name="normal" string="عمولات" domain="[('entry_type', '=', 'normal')]"/>
                <filter name="reversal" string="قيود عكس (مرتجعات وإلغاء)" domain="[('entry_type', '=', 'reversal')]"/>
                <filter name="adjustment" string="تسويات" domain="[('entry_type', '=', 'adjustment')]"/>
                <separator/>
                <filter name="approved_date" string="تاريخ الاعتماد" date="approved_at"/>
                <group expand="0" string="تجميع">
                    <filter name="by_employee" string="الفني" context="{'group_by': 'employee_id'}"/>
                    <filter name="by_company" string="الفرع" context="{'group_by': 'company_id'}"/>
                    <filter name="by_state" string="الحالة" context="{'group_by': 'state'}"/>
                    <filter name="by_type" string="النوع" context="{'group_by': 'entry_type'}"/>
                    <filter name="by_order" string="أمر التركيب" context="{'group_by': 'order_id'}"/>
                    <filter name="by_month" string="شهر الاعتماد" context="{'group_by': 'approved_at:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wof_commissions" model="ir.actions.act_window">
        <field name="name">متابعة العمولات</field>
        <field name="res_model">wof.technician.commission</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_wof_technician_commission_search"/>
        <field name="context">{'search_default_live': 1, 'search_default_by_employee': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">لا توجد عمولات بعد</p>
            <p>تُنشأ عمولة الفنيين تلقائيًا عند إرسال أمر التركيب لفحص الجودة، وتُعتمد عند التسليم أو ترحيل الفاتورة حسب تهيئة الفيلم. هذه الشاشة للمتابعة فقط؛ التصحيح من أمر التركيب بإعادة الاحتساب أو التسوية.</p>
        </field>
    </record>

    <menuitem id="menu_wof_commissions" name="متابعة العمولات" parent="menu_wo_v4_operation"
              action="action_wof_commissions" sequence="4"
              groups="yousentech_wo_v4.group_wo_supervisor,yousentech_wo_v4.group_wo_manager"/>

    <!-- Recalculation (manager, with a reason and a preview) -->
    <record id="view_wof_commission_recalc_wizard_form" model="ir.ui.view">
        <field name="name">wof.commission.recalc.wizard.form</field>
        <field name="model">wof.commission.recalc.wizard</field>
        <field name="arch" type="xml">
            <form string="إعادة احتساب العمولة">
                <field name="order_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="has_paid" invisible="1"/>
                <div class="alert alert-info" role="status">
                    <i class="fa fa-calculator me-1" title="احتساب"/>
                    تُحسب العمولة من جديد بالإعدادات الحالية: عمولة الفيلم لحجم السيارة، وطريقة التوزيع، ونسب الفنيين، وشرط إنجاز المهام، وبعد خصم ما أُرجع بإشعارات دائنة.
                    العمولات غير المدفوعة تُستبدل (وتبقى القديمة في السجل)، والمدفوعة تُضاف لها تسوية بالفرق.
                </div>
                <div class="alert alert-warning" role="alert" invisible="not has_paid">
                    <i class="fa fa-exclamation-triangle me-1" title="تنبيه"/> بعض هذه العمولات مدفوعة: لن تتغير، وسيُسجَّل الفرق تسويةً تُحتسب في الصرف القادم.
                </div>
                <field name="line_ids" nolabel="1">
                    <tree decoration-success="diff_amount &gt; 0" decoration-danger="diff_amount &lt; 0" decoration-muted="diff_amount == 0">
                        <field name="currency_id" column_invisible="1"/>
                        <field name="service"/>
                        <field name="employee_name"/>
                        <field name="old_amount" sum="الحالي"/>
                        <field name="new_amount" sum="الجديد"/>
                        <field name="diff_amount" sum="الفرق"/>
                        <field name="paid" widget="boolean"/>
                    </tree>
                </field>
                <group>
                    <field name="reason" required="1" placeholder="مثال: تصحيح نسبة الفني بعد مراجعة المشرف"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="تأكيد إعادة الاحتساب" class="btn-primary"/>
                    <button special="cancel" string="رجوع" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_wof_commission_adjust_wizard_form" model="ir.ui.view">
        <field name="name">wof.commission.adjust.wizard.form</field>
        <field name="model">wof.commission.adjust.wizard</field>
        <field name="arch" type="xml">
            <form string="تسوية عمولة">
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <div class="alert alert-info" role="status">
                    <i class="fa fa-balance-scale me-1" title="تسوية"/>
                    مبلغ موجب يُضاف للفني، وسالب يُخصم منه. التسوية تُعتمد مباشرة وتبقى في سجل العمولات ولا تُحذف.
                </div>
                <group>
                    <field name="order_id" invisible="not order_id"/>
                    <field name="employee_id" options="{'no_create': True}"/>
                    <field name="amount"/>
                    <field name="reason" placeholder="سبب التسوية"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="تسجيل التسوية" class="btn-primary"/>
                    <button special="cancel" string="رجوع" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
