<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <!-- ✅ تعديل عرض الشجرة -->
  <record id="view_oil_work_order_shift_tree_ext" model="ir.ui.view">
    <field name="name">oil.work.order.tree.inherit.shift</field>
    <field name="model">oil.work.order</field>
    <field name="inherit_id" ref="yousentech_oil_workshop.view_work_order_tree"/>
    <field name="arch" type="xml">
      <field name="order_seq" position="after">
        <field name="shift_id" readonly="1"/>
      </field>
    </field>
  </record>

  <!-- ✅ تعديل عرض النموذج -->
  <record id="view_oil_work_order_shift_form_ext" model="ir.ui.view">
    <field name="name">oil.work.order.form.inherit.shift</field>
    <field name="model">oil.work.order</field>
    <field name="inherit_id" ref="yousentech_oil_workshop.view_work_order_form"/>
    <field name="arch" type="xml">
      <field name="order_seq" position="after">
        <field name="shift_id" readonly="1" force_save="1"/>
      </field>
    </field>
  </record>
</odoo>
