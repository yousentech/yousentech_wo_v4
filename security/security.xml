<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================
         Module Category
    ========================== -->
    <record model="ir.module.category" id="wo_category_priv">
        <field name="name">صلاحيات نظام الأفلام</field>
        <field name="sequence">110</field>
    </record>


    <!-- =========================
         Groups
    ========================== -->

    <record id="group_wo_employee" model="res.groups">
        <field name="name">مستخدم نظام العناية</field>
        <field name="category_id" ref="wo_category_priv"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_wo_user" model="res.groups">
        <field name="name">موظف الاستقبال</field>
        <field name="category_id" ref="wo_category_priv"/>
        <field name="implied_ids" eval="[(4, ref('group_wo_employee'))]"/>
    </record>

    <record id="group_wo_technician" model="res.groups">
        <field name="name">فني</field>
        <field name="category_id" ref="wo_category_priv"/>
        <field name="implied_ids" eval="[(4, ref('group_wo_employee'))]"/>
    </record>

    <record id="group_wo_supervisor" model="res.groups">
        <field name="name">مشرف التشغيل</field>
        <field name="category_id" ref="wo_category_priv"/>
        <field name="implied_ids" eval="[(4, ref('group_wo_employee'))]"/>
    </record>

    <record id="group_wo_accountant" model="res.groups">
        <field name="name">محاسب نظام العناية</field>
        <field name="category_id" ref="wo_category_priv"/>
        <field name="implied_ids" eval="[(4, ref('group_wo_employee'))]"/>
    </record>

    <record id="group_wo_price_override" model="res.groups">
        <field name="name">اعتماد تجاوز سعر أمر التركيب</field>
        <field name="category_id" ref="wo_category_priv"/>
        <field name="implied_ids" eval="[(4, ref('group_wo_employee'))]"/>
    </record>

    <record id="group_wo_manager" model="res.groups">
        <field name="name">مدير مركز العناية</field>
        <field name="category_id" ref="wo_category_priv"/>
        <field name="implied_ids" eval="[
            (4, ref('group_wo_supervisor')),
            (4, ref('group_wo_accountant')),
            (4, ref('group_wo_price_override'))
        ]"/>
    </record>

    <record id="group_wo_settings" model="res.groups">
        <field name="name">مسؤول تهيئة نظام العناية</field>
        <field name="category_id" ref="wo_category_priv"/>
        <field name="implied_ids" eval="[(4, ref('group_wo_manager'))]"/>
    </record>

    <record id="installation_order_technician_assignment_rule" model="ir.rule">
        <field name="name">الفني يرى أوامر التركيب المسندة إليه</field>
        <field name="model_id" ref="model_wof_installation_order"/>
        <field name="domain_force">[('technician_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_wo_technician'))]"/>
    </record>

    <record id="installation_order_line_technician_assignment_rule" model="ir.rule">
        <field name="name">الفني يرى خدمات أوامره المسندة</field>
        <field name="model_id" ref="model_wof_installation_order_line"/>
        <field name="domain_force">[('order_id.technician_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_wo_technician'))]"/>
    </record>

    <record id="installation_material_technician_assignment_rule" model="ir.rule">
        <field name="name">الفني يرى مواد أوامره المسندة</field>
        <field name="model_id" ref="model_wof_installation_material_line"/>
        <field name="domain_force">[('order_id.technician_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_wo_technician'))]"/>
    </record>

    <record id="installation_event_technician_assignment_rule" model="ir.rule">
        <field name="name">الفني يرى أحداث أوامره المسندة</field>
        <field name="model_id" ref="model_wof_installation_order_event"/>
        <field name="domain_force">[('order_id.technician_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_wo_technician'))]"/>
    </record>

</odoo>
