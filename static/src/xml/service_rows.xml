<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Technicians of a service or a part: tags with × and an «add» picker
         (clicking a selected name in the picker removes it too). -->
    <t t-name="yousentech_wo_v4.ServiceRows.Team">
        <span class="wof_sparts_tags">
            <t t-set="tags" t-value="techTags(data, holder)"/>
            <t t-foreach="tags" t-as="tag" t-key="tag_index">
                <span class="wof_sparts_tag">
                    <t t-esc="tag.name"/>
                    <button t-if="tag.id and canToggleTech(data, tag.id)" type="button" class="wof_sparts_x"
                            t-att-disabled="state.busy" t-att-title="'إزالة ' + tag.name"
                            t-on-click="() => this.onTeamToggle(lineId, part, tag.id)">×</button>
                </span>
            </t>
            <span t-if="!tags.length" class="is-muted">—</span>
            <button t-if="data.can_team" type="button" class="wof_sparts_add" t-att-disabled="state.busy"
                    title="إضافة فني" t-on-click="() => this.openPicker(lineId, part)"><i class="fa fa-user-plus" title="إضافة فني"/></button>
        </span>
        <div t-if="isPickerOpen(lineId, part)" class="wof_sparts_pick">
            <t t-foreach="data.technicians" t-as="t" t-key="t.id">
                <button type="button" t-attf-class="wof_sparts_chip {{ holder.technician_ids.includes(t.id) ? 'is-on' : '' }}"
                        t-att-disabled="!canToggleTech(data, t.id) or state.busy" t-on-click="() => this.onTeamToggle(lineId, part, t.id)">
                    <i t-if="holder.technician_ids.includes(t.id)" class="fa fa-check me-1" title="مختار"/><t t-esc="t.name"/>
                </button>
            </t>
            <small t-if="!data.technicians.length">لا يوجد فنيون في فريق فرع الأمر.</small>
            <button type="button" class="wof_sparts_done" t-on-click="() => this.openPicker(lineId, part)">تم</button>
        </div>
    </t>

    <t t-name="yousentech_wo_v4.ServiceRows">
        <div class="wof_srows">
            <div t-if="!rows.length" class="wof_srows_empty">لا توجد خدمات بعد. اضغط «إضافة خدمة».</div>
            <t t-foreach="rows" t-as="row" t-key="row.rec.id">
                <div t-attf-class="wof_srow {{ row.area ? 'is-area' : '' }} {{ row.open ? 'is-open' : '' }}" t-attf-style="--act: {{ row.color }}">
                    <div class="wof_srow_main" t-on-click="(ev) => ev.target.closest('button') or this.toggle(row)">
                        <span class="wof_srow_icon" t-esc="row.letter"/>
                        <div class="wof_srow_title">
                            <b><t t-esc="row.title"/> <span>· <t t-esc="row.film"/></span></b>
                            <small>
                                <t t-esc="row.activity"/> ·
                                <t t-if="row.area">منطقة خدمة<t t-if="row.template"> · نموذج «<t t-esc="row.template"/>» (<t t-esc="row.partCount"/> أجزاء)</t></t>
                                <t t-else="">جزء</t>
                            </small>
                        </div>
                        <div class="wof_srow_cell"><small>الدرجة</small><b t-esc="row.grade"/></div>
                        <div class="wof_srow_cell">
                            <small>الصنف</small>
                            <b t-if="!row.usesInventory" class="is-muted">لا يُصرف</b>
                            <b t-elif="row.area and row.missing" class="is-warn">ناقص <t t-esc="row.missing"/> من <t t-esc="row.partCount"/></b>
                            <b t-elif="row.area">مكتمل · <t t-esc="row.partCount"/> أجزاء</b>
                            <b t-elif="row.product"><t t-esc="row.product"/> · <t t-esc="row.productQty"/></b>
                            <b t-else="" class="is-warn">غير محدد</b>
                        </div>
                        <div class="wof_srow_cell"><small>الفنيون</small><b t-if="row.team" t-esc="row.team"/><b t-else="" class="is-muted">—</b></div>
                        <div class="wof_srow_end">
                            <div class="wof_srow_price">
                                <b><t t-esc="fmt(row.price)"/> <small t-esc="currency"/></b>
                                <small t-if="row.discount" class="wof_srow_disc">خصم <t t-esc="fmt(row.discount)"/></small>
                            </div>
                            <button type="button" class="wof_srow_btn is-icon is-toggle" t-att-title="row.open ? 'إغلاق' : 'فتح وتعديل'" t-on-click="() => this.toggle(row)">
                                <i t-attf-class="fa {{ row.open ? 'fa-chevron-up' : 'fa-chevron-down' }}" title="فتح"/>
                            </button>
                            <button t-if="editable and !props.readonly" type="button" class="wof_srow_btn is-icon is-danger" title="حذف الخدمة" t-on-click="() => this.removeRow(row)">
                                <i class="fa fa-trash-o" title="حذف"/>
                            </button>
                        </div>
                    </div>

                    <t t-if="row.open">
                        <t t-set="data" t-value="state.areas[row.id]"/>
                        <div t-if="!data" class="wof_spart_loading">جارٍ التحميل…</div>
                        <div t-else="" class="wof_sparts">

                            <!-- Single part: one compact editing strip -->
                            <div t-if="!data.area" class="wof_sedit">
                                <label t-if="data.grades.length" class="wof_sedit_f">
                                    <small>الدرجة</small>
                                    <select class="wof_sparts_sel" t-att-disabled="!data.can_commercial or state.busy" t-on-change="(ev) => this.onLineSelect(row.id, 'film_category_line_id', ev)">
                                        <option value="">—</option>
                                        <t t-foreach="data.grades" t-as="g" t-key="g.id"><option t-att-value="g.id" t-att-selected="g.id === data.grade_id" t-esc="g.name"/></t>
                                    </select>
                                </label>
                                <label t-if="data.uses_inventory" class="wof_sedit_f">
                                    <small>الصنف المخزني</small>
                                    <select t-attf-class="wof_sparts_sel {{ data.product_id ? '' : 'is-warn' }}" t-att-disabled="!data.can_commercial or state.busy" t-on-change="(ev) => this.onLineSelect(row.id, 'film_product_id', ev)">
                                        <option value="">اختر الصنف</option>
                                        <t t-foreach="data.products" t-as="p" t-key="p.id"><option t-att-value="p.id" t-att-selected="p.id === data.product_id" t-esc="p.name"/></t>
                                    </select>
                                </label>
                                <label t-if="data.uses_inventory" class="wof_sedit_f is-small">
                                    <small>الكمية</small>
                                    <input type="number" min="0" step="0.1" class="wof_sparts_num" t-att-value="data.product_qty" t-att-disabled="!data.can_setup or state.busy" t-on-change="(ev) => this.onLineQty(row.id, ev)"/>
                                </label>
                                <div class="wof_sedit_f is-team">
                                    <small>الفنيون</small>
                                    <t t-call="yousentech_wo_v4.ServiceRows.Team">
                                        <t t-set="holder" t-value="data"/><t t-set="lineId" t-value="row.id"/><t t-set="part" t-value="false"/>
                                    </t>
                                </div>
                                <label class="wof_sedit_f is-small">
                                    <small>التقدم</small>
                                    <span class="wof_sparts_prog">
                                        <span class="wof_sparts_meter"><i t-attf-style="width: {{ data.progress }}%"/></span>
                                        <input t-if="data.can_progress" type="number" min="0" max="100" step="10" class="wof_sparts_num is-small" t-att-value="data.progress" t-att-disabled="state.busy" t-on-change="(ev) => this.onLineProgress(row.id, ev)"/>
                                        <span t-else=""><t t-esc="data.progress"/>٪</span>
                                    </span>
                                </label>
                            </div>

                            <!-- Service area: template + parts table -->
                            <t t-if="data.area">
                                <div t-if="data.templates.length" class="wof_sparts_tpl">
                                    <small>النموذج:</small>
                                    <t t-foreach="data.templates" t-as="tpl" t-key="tpl.id">
                                        <button type="button" t-attf-class="wof_sparts_opt {{ tpl.id === data.template_id ? 'is-on' : '' }}"
                                                t-att-disabled="!data.can_template or state.busy or tpl.id === data.template_id"
                                                t-on-click="() => this.setTemplate(row.id, tpl.id)">
                                            <t t-esc="tpl.name"/><t t-if="tpl.is_default"> (افتراضي)</t>
                                        </button>
                                    </t>
                                    <small t-if="data.can_template" class="wof_sparts_note">تغيير النموذج يعيد بناء الأجزاء بالقيم الافتراضية</small>
                                </div>
                                <table class="wof_sparts_table">
                                    <thead>
                                        <tr>
                                            <th>الجزء</th>
                                            <th t-if="data.grades.length">الدرجة</th>
                                            <th t-if="data.uses_inventory">الصنف المخزني</th>
                                            <th t-if="data.uses_inventory" class="is-qty">الكمية</th>
                                            <th>الفنيون</th>
                                            <th class="is-progress">التقدم</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="data.parts" t-as="part" t-key="part.id">
                                            <tr>
                                                <td class="is-name" t-esc="part.name"/>
                                                <td t-if="data.grades.length">
                                                    <select class="wof_sparts_sel" t-att-disabled="!data.can_setup or state.busy" t-on-change="(ev) => this.onSelect(row.id, part, 'grade_id', ev)">
                                                        <option value="">—</option>
                                                        <t t-foreach="data.grades" t-as="g" t-key="g.id"><option t-att-value="g.id" t-att-selected="g.id === part.grade_id" t-esc="g.name"/></t>
                                                    </select>
                                                </td>
                                                <td t-if="data.uses_inventory">
                                                    <select t-attf-class="wof_sparts_sel {{ part.product_id ? '' : 'is-warn' }}" t-att-disabled="!data.can_setup or state.busy" t-on-change="(ev) => this.onSelect(row.id, part, 'product_id', ev)">
                                                        <option value="">اختر الصنف</option>
                                                        <t t-foreach="data.products" t-as="p" t-key="p.id"><option t-att-value="p.id" t-att-selected="p.id === part.product_id" t-esc="p.name"/></t>
                                                    </select>
                                                </td>
                                                <td t-if="data.uses_inventory" class="is-qty">
                                                    <input type="number" min="0" step="0.1" class="wof_sparts_num" t-att-value="part.product_qty" t-att-disabled="!data.can_setup or state.busy" t-on-change="(ev) => this.onQty(row.id, part, ev)"/>
                                                </td>
                                                <td class="is-team">
                                                    <t t-call="yousentech_wo_v4.ServiceRows.Team">
                                                        <t t-set="holder" t-value="part"/><t t-set="lineId" t-value="row.id"/>
                                                    </t>
                                                </td>
                                                <td class="is-progress">
                                                    <span class="wof_sparts_prog">
                                                        <span class="wof_sparts_meter"><i t-attf-style="width: {{ part.progress }}%"/></span>
                                                        <input t-if="data.can_progress" type="number" min="0" max="100" step="10" class="wof_sparts_num is-small" t-att-value="part.progress" t-att-disabled="state.busy" t-on-change="(ev) => this.onProgress(row.id, part, ev)"/>
                                                        <span t-elif="part.progress === 100" class="is-ok">✓</span>
                                                        <span t-else=""><t t-esc="part.progress"/>٪</span>
                                                    </span>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                                <div t-if="data.can_setup" class="wof_sparts_bulk">
                                    <small>تطبيق على كل الأجزاء:</small>
                                    <select t-if="data.grades.length" class="wof_sparts_sel" t-att-disabled="state.busy" t-on-change="(ev) => this.applyAll(row.id, 'grade_id', ev)">
                                        <option value="">الدرجة</option>
                                        <t t-foreach="data.grades" t-as="g" t-key="g.id"><option t-att-value="g.id" t-esc="g.name"/></t>
                                    </select>
                                    <select t-if="data.uses_inventory" class="wof_sparts_sel" t-att-disabled="state.busy" t-on-change="(ev) => this.applyAll(row.id, 'product_id', ev)">
                                        <option value="">الصنف</option>
                                        <t t-foreach="data.products" t-as="p" t-key="p.id"><option t-att-value="p.id" t-esc="p.name"/></t>
                                    </select>
                                    <select class="wof_sparts_sel" t-att-disabled="state.busy" t-on-change="(ev) => this.applyAll(row.id, 'technician_ids', ev)">
                                        <option value="">الفني</option>
                                        <t t-foreach="data.technicians" t-as="t" t-key="t.id"><option t-att-value="t.id" t-esc="t.name"/></t>
                                    </select>
                                </div>
                            </t>

                            <!-- Discount of the service (when discounts are per service) + advanced -->
                            <div class="wof_sfoot">
                                <div t-if="data.discount.shown" class="wof_sdisc">
                                    <small>الخصم</small>
                                    <select class="wof_sparts_sel is-tiny" t-att-disabled="!data.discount.allowed or state.busy" t-on-change="(ev) => this.onDiscountType(row.id, ev)">
                                        <option value="percent" t-att-selected="data.discount.type === 'percent'">%</option>
                                        <option value="amount" t-att-selected="data.discount.type === 'amount'">مبلغ</option>
                                    </select>
                                    <input type="number" min="0" step="0.5" class="wof_sparts_num" placeholder="0"
                                           t-att-value="data.discount.value or ''" t-att-disabled="!data.discount.allowed or state.busy"
                                           t-on-change="(ev) => this.onDiscountValue(row.id, ev)"/>
                                    <small class="wof_sdisc_hint">الحد <t t-esc="data.discount.max_percent"/>٪<t t-if="data.discount.amount"> · = <t t-esc="fmt(data.discount.amount)"/></t></small>
                                </div>
                                <button type="button" class="wof_sadv" t-on-click="() => this.openDetails(row)">
                                    <i class="fa fa-sliders me-1" title="متقدم"/> خيارات متقدمة (تجاوز السعر، الملاحظات)
                                </button>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>

</templates>
