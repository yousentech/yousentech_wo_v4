<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_car_parts_form" model="ir.ui.view">
        <field name="name">wof.car.parts.form</field>
        <field name="model">wof.car.parts</field>
        <field name="arch" type="xml">

            <form string="أجزاء السيارة">
                <sheet>

                    <notebook>

                        <!-- ================= BASIC ================= -->
                        <page string="البيانات الأساسية">

                            <group>
                                <field name="name"/>
                                <field name="priority_part"/>
                                <field name="service_type_id"/>
                                <field name="company_id"/>
                                <field name="product_id"/>
                            </group>

                        </page>

                        <!-- ================= PRICING ================= -->
                        <page string="الأسعار والعمولة">

                            <group>
                                <field name="commission"/>
                                <field name="default_qty"/>
                                <field name="price_readonly"/>
                                <field name="size_readonly"/>
                            </group>

                        </page>

                        <!-- ================= LIMITS ================= -->
                        <page string="الحدود">

                            <group>
                                <field name="min_qty"/>
                                <field name="max_qty"/>
                            </group>

                        </page>

                        <!-- ================= LINES ================= -->
                        <page string="التصنيفات">

                            <field name="part_lines">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="default_selection"/>
                                </tree>
                            </field>

                        </page>

                        <!-- ================= COMMISSION ================= -->
                        <page string="العمولات والأسعار">

                            <field name="part_com_lines">
                                <tree editable="bottom">
                                    <field name="service_type_id"/>
                                    <field name="film_category_id"/>
                                    <field name="car_size_id"/>
                                    <field name="part_price"/>
                                    <field name="commission"/>
                                    <field name="discount_exceed_limit"/>
                                    <field name="price_readonly"/>
                                </tree>
                            </field>

                        </page>

                        <!-- ================= SIZES ================= -->
                        <page string="المقاسات">

                            <field name="part_sizes_lines">
                                <tree editable="bottom">
                                    <field name="service_type_id"/>
                                    <field name="film_category_id"/>
                                    <field name="car_size_id"/>
                                    <field name="default_qty"/>
                                    <field name="min_qty"/>
                                    <field name="max_qty"/>
                                    <field name="size_readonly"/>
                                </tree>
                            </field>

                        </page>

                    </notebook>

                </sheet>
            </form>

        </field>
    </record>
    <record id="view_car_parts_lines_form" model="ir.ui.view">
        <field name="name">wof.car.parts.lines.form</field>
        <field name="model">wof.car.parts.lines</field>
        <field name="arch" type="xml">

            <form>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="default_selection"/>
                        <field name="header_id"/>
                    </group>

                    <field name="sub_part_ids">
                        <tree editable="bottom">
                            <field name="car_part_id"/>
                            <field name="car_size_id"/>
                            <field name="film_category_id"/>
                            <field name="film_category_line_id"/>
                            <field name="default_film_product_id"/>
                            <field name="package_film_product_id"/>
                            <field name="is_effected_in_inventory"/>
                        </tree>
                    </field>

                </sheet>
            </form>

        </field>
    </record>
    <record id="view_car_parts_sub_parts_form" model="ir.ui.view">
        <field name="name">wof.car.parts.sub.parts.form</field>
        <field name="model">wof.car.parts.sub.parts</field>
        <field name="arch" type="xml">

            <form>
                <sheet>

                    <group>
                        <field name="line_id"/>
                        <field name="header_id"/>
                        <field name="service_type_id"/>
                    </group>

                    <group>
                        <field name="car_part_id"/>
                        <field name="car_size_id"/>
                        <field name="film_category_id"/>
                    </group>

                    <group>
                        <field name="film_category_line_id"/>
                        <field name="default_film_product_id"/>
                        <field name="package_film_category_line_id"/>
                        <field name="package_film_product_id"/>
                    </group>

                    <group>
                        <field name="is_effected_in_inventory"/>
                    </group>

                </sheet>
            </form>

        </field>
    </record>
    <record id="view_car_parts_com_lines_form" model="ir.ui.view">
        <field name="name">wof.car.parts.com.lines.form</field>
        <field name="model">wof.car.parts.com.lines</field>
        <field name="arch" type="xml">

            <form>
                <sheet>

                    <group>
                        <field name="header_id"/>
                        <field name="service_type_id"/>
                    </group>

                    <group>
                        <field name="film_category_id"/>
                        <field name="car_size_id"/>
                    </group>

                    <group>
                        <field name="part_price"/>
                        <field name="commission"/>
                        <field name="discount_exceed_limit"/>
                        <field name="price_readonly"/>
                    </group>

                    <group>
                        <field name="film_category_line_id"/>
                        <field name="film_product_id"/>
                        <field name="package_film_product_id"/>
                    </group>

                </sheet>
            </form>

        </field>
    </record>
    <record id="view_car_parts_size_lines_form" model="ir.ui.view">
        <field name="name">wof.car.parts.size.lines.form</field>
        <field name="model">wof.car.parts.size.lines</field>
        <field name="arch" type="xml">

            <form>
                <sheet>

                    <group>
                        <field name="header_id"/>
                        <field name="service_type_id"/>
                    </group>

                    <group>
                        <field name="film_category_id"/>
                        <field name="car_size_id"/>
                    </group>

                    <group>
                        <field name="default_qty"/>
                        <field name="min_qty"/>
                        <field name="max_qty"/>
                        <field name="size_readonly"/>
                    </group>

                    <group>
                        <field name="is_effected_in_inventory"/>
                    </group>

                </sheet>
            </form>

        </field>
    </record>
</odoo>