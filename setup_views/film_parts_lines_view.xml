<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_film_parts_wo_v4_lines_tree" model="ir.ui.view">
        <field name="name">wof.film.parts.lines.tree</field>
        <field name="model">wof.film.parts.lines</field>
        <field name="arch" type="xml">
            <tree>
                <field name="header_id"/>
                <field name="service_type_id"/>
                <field name="car_part_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="part_selected"/>
                <field name="price_count"/>
                <field name="commission_count"/>
            </tree>
        </field>
    </record>

    <record id="view_film_parts_wo_v4_lines_form" model="ir.ui.view">
        <field name="name">wof.film.parts.lines.form</field>
        <field name="model">wof.film.parts.lines</field>
        <field name="arch" type="xml">
            <form string="جزء مرتبط بفيلم">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_price_lines" type="object"
                                class="oe_stat_button" icon="fa-money">
                            <field name="price_count" widget="statinfo" string="التسعيرات"/>
                        </button>
                        <button name="action_open_commission_lines" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="commission_count" widget="statinfo" string="العمولات"/>
                        </button>
                    </div>
                    <group>
                        <field name="header_id"/>
                        <field name="service_type_id" readonly="1"/>
                        <field name="company_id" readonly="1"
                               groups="base.group_multi_company"/>
                        <field name="car_part_id"/>
                        <field name="film_category_line_id"/>
                        <field name="part_selected"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_film_parts_wo_v4_lines" model="ir.actions.act_window">
        <field name="name">أجزاء الأفلام</field>
        <field name="res_model">wof.film.parts.lines</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
