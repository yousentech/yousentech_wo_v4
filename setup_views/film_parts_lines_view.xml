<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_film_parts_wo_v4_lines_tree" model="ir.ui.view">
        <field name="name">wof.film.parts.lines.tree</field>
        <field name="model">wof.film.parts.lines</field>
        <field name="arch" type="xml">
            <tree string="مكوّنات الخدمات" decoration-muted="not part_selected">
                <field name="company_id" column_invisible="1"/>
                <field name="header_id" string="الخدمة / الفيلم"/>
                <field name="service_type_id" string="نشاط المركز"/>
                <field name="car_part_id" string="المكوّن"/>
                <field name="price_mode" widget="badge"/>
                <field name="commission_mode" widget="badge"/>
                <field name="part_selected" string="مفعّل"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_film_parts_wo_v4_lines_form" model="ir.ui.view">
        <field name="name">wof.film.parts.lines.form</field>
        <field name="model">wof.film.parts.lines</field>
        <field name="arch" type="xml">
            <form string="مكوّن خدمة" class="wof_service_architecture">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="supports_color_grades" invisible="1"/>
                    <div class="wof_service_hero wof_service_hero_compact">
                        <div class="wof_service_hero_copy">
                            <span class="wof_service_eyebrow">مكوّن الخدمة</span>
                            <h1><field name="car_part_id" string="المكوّن"/></h1>
                            <p>السعر والعمولة قد يكونان عامين أو مخصصين حسب حجم السيارة.</p>
                        </div>
                        <div class="wof_service_hero_code">
                            <small>الخدمة</small>
                            <strong><field name="header_id"/></strong>
                        </div>
                    </div>

                    <div class="wof_service_summary">
                        <div class="wof_service_summary_card">
                            <small>سياسة السعر</small>
                            <strong><field name="price_mode" widget="badge" readonly="1"/></strong>
                        </div>
                        <div class="wof_service_summary_card">
                            <small>سياسة العمولة</small>
                            <strong><field name="commission_mode" widget="badge" readonly="1"/></strong>
                        </div>
                        <div class="wof_service_summary_card">
                            <small>الحالة</small>
                            <strong><field name="part_selected"/></strong>
                        </div>
                    </div>

                    <notebook class="wof_service_notebook">
                        <page string="البيانات الأساسية">
                            <group col="2">
                                <group>
                                    <field name="header_id" string="الخدمة / الفيلم"/>
                                    <field name="service_type_id" string="نشاط المركز" readonly="1"/>
                                    <field name="company_id" readonly="1"
                                           groups="base.group_multi_company"/>
                                </group>
                                <group>
                                    <field name="car_part_id" string="مكوّن الخدمة"/>
                                    <field name="film_category_line_id"
                                           invisible="not supports_color_grades"/>
                                    <field name="part_selected"/>
                                </group>
                            </group>
                        </page>
                        <page string="الأسعار">
                            <div class="wof_section_intro">
                                السطر بلا حجم هو السعر العام. السطر الذي يحمل حجمًا يستبدله لذلك الحجم.
                            </div>
                            <field name="price_line_ids">
                                <tree editable="bottom">
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="car_size_id"
                                           placeholder="بلا حجم = سعر عام"/>
                                    <field name="part_price"/>
                                    <field name="tax_id"/>
                                    <field name="discount_exceed_limit" optional="hide"/>
                                    <field name="free_part"/>
                                </tree>
                            </field>
                        </page>
                        <page string="العمولات">
                            <div class="wof_section_intro">
                                السطر بلا حجم هو العمولة العامة، ويمكن تخصيص عمولة لكل حجم.
                            </div>
                            <field name="commission_line_ids">
                                <tree editable="bottom">
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="car_size_id"
                                           placeholder="بلا حجم = عمولة عامة"/>
                                    <field name="commission"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_film_parts_wo_v4_lines" model="ir.actions.act_window">
        <field name="name">مكوّنات الخدمات</field>
        <field name="res_model">wof.film.parts.lines</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
