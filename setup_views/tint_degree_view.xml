<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_wof_tint_degree_tree" model="ir.ui.view">
        <field name="name">wof.tint.degree.tree</field>
        <field name="model">wof.tint.degree</field>
        <field name="arch" type="xml">
            <tree decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="value"/>
                <field name="display_name"/>
                <field name="company_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_wof_tint_degree_form" model="ir.ui.view">
        <field name="name">wof.tint.degree.form</field>
        <field name="model">wof.tint.degree</field>
        <field name="arch" type="xml">
            <form string="درجة لون">
                <sheet>

                    <div class="alert alert-primary text-center p-3" role="status">
                        <h3>
                            <i class="fa fa-adjust me-1" title="درجة اللون"/>
                            درجة لون العزل الحراري
                        </h3>
                        <div class="text-muted">
                            هذه الدرجات تستخدم فقط مع أفلام العزل الحراري.
                        </div>
                    </div>

                    <group col="2">
                        <group>
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="value"/>
                        </group>
                        <group>
                            <field name="display_name" readonly="1"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wof_tint_degree_search" model="ir.ui.view">
        <field name="name">wof.tint.degree.search</field>
        <field name="model">wof.tint.degree</field>
        <field name="arch" type="xml">
            <search string="بحث درجات اللون">
                <field name="name"/>
                <field name="value"/>
                <field name="company_id"/>

                <filter string="المفعلة"
                        name="active_only"
                        domain="[('active','=',True)]"/>

                <filter string="المؤرشفة"
                        name="inactive_only"
                        domain="[('active','=',False)]"/>

                <group expand="0" string="تجميع">
                    <filter string="الشركة"
                            name="groupby_company"
                            context="{'group_by':'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_wof_tint_degree" model="ir.actions.act_window">
        <field name="name">درجات اللون</field>
        <field name="res_model">wof.tint.degree</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_wof_tint_degree_search"/>
        <field name="context">{'search_default_active_only': 1}</field>
    </record>

    <menuitem id="menu_wof_tint_degree"
              name="درجات اللون"
              parent="menu_wo_v4_configuration"
              action="action_wof_tint_degree"
              sequence="35"  />

</odoo>