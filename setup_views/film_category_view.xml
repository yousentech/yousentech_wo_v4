<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_film_category_wo_v4_tree" model="ir.ui.view">
        <field name="name">wof.film.category.tree</field>
        <field name="model">wof.film.category</field>
        <field name="arch" type="xml">
            <tree string="الخدمات والأفلام" decoration-muted="not active">
                <field name="company_id" column_invisible="1"/>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="service_type_id" string="نشاط المركز"/>
                <field name="item_type"/>
                <field name="parts_count" string="المكوّنات"/>
                <field name="pricing_summary"/>
                <field name="commission_summary" optional="hide"/>
                <field name="grade_count" string="درجات اللون" optional="hide"/>
                <field name="warranty_years" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_film_category_wo_v4_kanban" model="ir.ui.view">
        <field name="name">wof.film.category.kanban</field>
        <field name="model">wof.film.category</field>
        <field name="arch" type="xml">
            <kanban class="wof_film_kanban" create="1" default_order="sequence,name">
                <field name="name"/><field name="code"/><field name="item_type"/><field name="company_id"/>
                <field name="service_type_id"/><field name="active"/>
                <field name="configuration_ready"/><field name="configuration_state"/>
                <field name="configuration_note"/><field name="parts_count"/>
                <field name="grade_count"/><field name="car_size_count"/>
                <field name="pricing_summary"/><field name="supports_color_grades"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click wof_film_card #{record.active.raw_value ? '' : 'wof_film_card_inactive'}">
                            <div class="wof_film_card_header">
                                <div class="wof_film_title">
                                    <strong><field name="name"/></strong>
                                    <div class="wof_film_badges">
                                        <span class="wof_badge wof_badge_kind"><field name="item_type"/></span>
                                        <span t-if="record.active.raw_value" class="wof_badge wof_badge_active"><i class="fa fa-check-circle" title="مفعّل"/> مفعّل</span>
                                        <span t-else="" class="wof_badge wof_badge_muted"><i class="fa fa-times-circle" title="غير مفعّل"/> غير مفعّل</span>
                                    </div>
                                </div>
                                <button type="edit" class="wof_film_edit" title="تعديل"><i class="fa fa-pencil" title="تعديل"/></button>
                            </div>
                            <div class="wof_film_card_body">
                                <div t-if="record.configuration_ready.raw_value" class="wof_readiness wof_ready"><i class="fa fa-check-circle" title="جاهز"/> جاهز</div>
                                <div t-else="" class="wof_readiness wof_needs_setup"><i class="fa fa-exclamation-triangle" title="يحتاج إلى تهيئة"/> يحتاج إلى تهيئة</div>
                                <small t-if="!record.configuration_ready.raw_value" class="wof_configuration_note"><field name="configuration_note"/></small>
                                <div class="wof_film_metrics">
                                    <span><b><field name="parts_count"/></b> مكونات</span>
                                    <span t-if="record.supports_color_grades.raw_value"><b><field name="grade_count"/></b> درجات لون</span>
                                    <span t-if="record.car_size_count.raw_value"><b><field name="car_size_count"/></b> أحجام سيارات</span>
                                </div>
                                <div class="wof_pricing_line"><span>سياسة التسعير</span><strong><field name="pricing_summary"/></strong></div>
                            </div>
                            <div class="wof_film_card_footer">
                                <button name="action_configure" type="object" class="btn btn-primary wof_configure_btn">تهيئة</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_film_category_wo_v4_form" model="ir.ui.view">
        <field name="name">wof.film.category.form</field>
        <field name="model">wof.film.category</field>
        <field name="arch" type="xml">
            <form string="محرر الخدمة" class="wof_service_architecture">
                <header>
                    <button name="action_create_component" type="object"
                            string="إضافة مكوّن" class="btn-primary"
                            icon="fa-plus"
                            groups="yousentech_wo_v4.group_wo_manager"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="supports_color_grades" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="مؤرشف" bg_color="bg-danger"
                            invisible="active"/>

                    <div class="wof_service_hero">
                        <div class="wof_service_hero_copy">
                            <span class="wof_service_eyebrow">الخدمة / الفيلم</span>
                            <h1><field name="name" placeholder="مثال: عزل حراري بريميوم"/></h1>
                            <p>حدد النشاط، ثم المكوّنات، والسعر والعمولة. درجات اللون تظهر للعزل الحراري فقط.</p>
                        </div>
                        <div class="wof_service_hero_code">
                            <small>الكود الثابت</small>
                            <strong><field name="code" placeholder="TINT-PRO"/></strong>
                        </div>
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_components" type="object"
                                class="oe_stat_button" icon="fa-puzzle-piece">
                            <field name="parts_count" widget="statinfo" string="المكوّنات"/>
                        </button>
                        <button name="action_open_price_lines" type="object"
                                class="oe_stat_button" icon="fa-money">
                            <field name="price_count" widget="statinfo" string="التسعيرات"/>
                        </button>
                        <button name="action_open_commission_lines" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="commission_count" widget="statinfo" string="العمولات"/>
                        </button>
                    </div>

                    <div class="wof_service_summary">
                        <div class="wof_service_summary_card">
                            <small>النشاط</small>
                            <strong><field name="service_type_id" options="{'no_create': True}"/></strong>
                        </div>
                        <div class="wof_service_summary_card">
                            <small>سياسة السعر</small>
                            <strong><field name="pricing_summary" readonly="1"/></strong>
                        </div>
                        <div class="wof_service_summary_card">
                            <small>درجات اللون</small>
                            <strong invisible="not supports_color_grades"><field name="grade_count" readonly="1"/> درجة</strong>
                            <strong invisible="supports_color_grades">غير مطبقة</strong>
                        </div>
                    </div>

                    <notebook class="wof_service_notebook">
                        <page string="البيانات الأساسية" name="basic">
                            <div class="wof_service_cards">
                                <group class="wof_service_card" string="تعريف الخدمة">
                                    <field name="service_type_id" string="نشاط المركز"
                                           options="{'no_create': True}"/>
                                    <field name="description"
                                           placeholder="وصف مختصر للموظف"/>
                                    <field name="warranty_years"/>
                                    <field name="company_id" readonly="1"
                                           groups="base.group_multi_company"/>
                                </group>
                                <group class="wof_service_card" string="المخزون والضمان">
                                    <field name="is_effected_in_inventory"/>
                                    <field name="car_film_product_required"
                                           invisible="not is_effected_in_inventory"/>
                                    <field name="warning_msg"/>
                                    <field name="active"/>
                                </group>
                            </div>
                        </page>

                        <page string="المكوّنات" name="components">
                            <div class="wof_section_intro">
                                هذه هي المكوّنات التي سيختارها الموظف داخل أمر التركيب.
                            </div>
                            <field name="film_part_line_ids" context="{'default_header_id': id}">
                                <tree editable="bottom" decoration-muted="not part_selected">
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="header_id" column_invisible="1"/>
                                    <field name="supports_color_grades" column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="car_part_id" string="مكوّن الخدمة"/>
                                    <field name="price_mode" widget="badge"/>
                                    <field name="commission_mode" widget="badge"/>
                                    <field name="film_category_line_id"
                                           string="الدرجة الافتراضية"
                                           invisible="not supports_color_grades"
                                           optional="show"/>
                                    <field name="part_selected" string="مفعّل"/>
                                </tree>
                            </field>
                        </page>

                        <page string="الأسعار والعمولات" name="pricing">
                            <div class="wof_pricing_actions">
                                <div class="wof_service_card">
                                    <h3>التسعير</h3>
                                    <p>استخدم سطرًا بلا حجم للسعر العام، أو أضف سطرًا لكل حجم.</p>
                                    <field name="pricing_summary" readonly="1"/>
                                    <button name="action_open_price_lines" type="object"
                                            string="ضبط الأسعار" class="btn-primary"/>
                                </div>
                                <div class="wof_service_card">
                                    <h3>العمولات</h3>
                                    <p>العمولة يمكن أن تكون عامة أو مختلفة حسب حجم السيارة.</p>
                                    <field name="commission_summary" readonly="1"/>
                                    <button name="action_open_commission_lines" type="object"
                                            string="ضبط العمولات" class="btn-secondary"/>
                                </div>
                            </div>
                        </page>

                        <page string="درجات اللون" name="grades"
                              invisible="not supports_color_grades">
                            <div class="wof_section_intro">
                                تعرّف الدرجات مرة واحدة للخدمة، ثم تختار لكل مكوّن درجته الافتراضية.
                            </div>
                            <field name="film_category_line_ids" context="{'default_header_id': id}">
                                <tree editable="bottom" decoration-muted="not active">
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="header_id" column_invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="transmission_percent"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_film_category_wo_v4_search" model="ir.ui.view">
        <field name="name">wof.film.category.search</field>
        <field name="model">wof.film.category</field>
        <field name="arch" type="xml">
            <search string="البحث في الخدمات والأفلام">
                <field name="company_id" invisible="1"/>
                <field name="name"/>
                <field name="code"/>
                <field name="service_type_id" string="نشاط المركز"/>
                <filter name="inventory" string="يستخدم المخزون"
                        domain="[('is_effected_in_inventory', '=', True)]"/>
                <filter name="archived" string="مؤرشف"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="تجميع">
                    <filter name="group_service" string="نشاط المركز"
                            context="{'group_by': 'service_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_film_category_wo_v4" model="ir.actions.act_window">
        <field name="name">الخدمات والأفلام</field>
        <field name="res_model">wof.film.category</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_film_category_wo_v4_search"/>
        <field name="view_id" ref="view_film_category_wo_v4_kanban"/>
    </record>

    <record id="view_film_parts_price_lines_tree" model="ir.ui.view">
        <field name="name">wof.film.parts.price.lines.tree</field>
        <field name="model">wof.film.parts.price.lines</field>
        <field name="arch" type="xml">
            <tree editable="bottom" string="أسعار مكوّنات الخدمة">
                <field name="company_id" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="part_line_id"
                       domain="context.get('wof_default_film_id') and [('header_id', '=', context.get('wof_default_film_id'))] or []"/>
                <field name="header_id" readonly="1" optional="hide"/>
                <field name="car_part_id" readonly="1"/>
                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                <field name="car_size_id" placeholder="اتركه فارغًا للسعر العام"/>
                <field name="part_price"/>
                <field name="tax_id"/>
                <field name="discount_exceed_limit" optional="hide"/>
                <field name="price_readonly" optional="hide"/>
                <field name="free_part"/>
            </tree>
        </field>
    </record>

    <record id="view_film_parts_price_lines_form" model="ir.ui.view">
        <field name="name">wof.film.parts.price.lines.form</field>
        <field name="model">wof.film.parts.price.lines</field>
        <field name="arch" type="xml">
            <form string="تسعير مكوّن" class="wof_service_architecture">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="wof_section_intro">
                        اترك حجم السيارة فارغًا لإنشاء سعر عام، أو حدد الحجم لسعر مخصص.
                    </div>
                    <group col="2">
                        <group>
                            <field name="part_line_id"
                                   domain="context.get('wof_default_film_id') and [('header_id', '=', context.get('wof_default_film_id'))] or []"/>
                            <field name="header_id" readonly="1"/>
                            <field name="car_part_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="car_size_id"/>
                        </group>
                        <group>
                            <field name="part_price"/>
                            <field name="tax_id"/>
                            <field name="discount_exceed_limit"/>
                            <field name="price_readonly"/>
                            <field name="free_part"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_film_parts_price_lines" model="ir.actions.act_window">
        <field name="name">أسعار مكوّنات الخدمة</field>
        <field name="res_model">wof.film.parts.price.lines</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_film_parts_commission_lines_tree" model="ir.ui.view">
        <field name="name">wof.film.parts.commission.lines.tree</field>
        <field name="model">wof.film.parts.commission.lines</field>
        <field name="arch" type="xml">
            <tree editable="bottom" string="عمولات مكوّنات الخدمة">
                <field name="company_id" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="part_line_id"
                       domain="context.get('wof_default_film_id') and [('header_id', '=', context.get('wof_default_film_id'))] or []"/>
                <field name="header_id" readonly="1" optional="hide"/>
                <field name="car_part_id" readonly="1"/>
                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                <field name="car_size_id" placeholder="اتركه فارغًا للعمولة العامة"/>
                <field name="commission"/>
            </tree>
        </field>
    </record>

    <record id="view_film_parts_commission_lines_form" model="ir.ui.view">
        <field name="name">wof.film.parts.commission.lines.form</field>
        <field name="model">wof.film.parts.commission.lines</field>
        <field name="arch" type="xml">
            <form string="عمولة مكوّن" class="wof_service_architecture">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="wof_section_intro">
                        اترك حجم السيارة فارغًا للعمولة العامة، أو حدد الحجم لعمولة مخصصة.
                    </div>
                    <group>
                        <field name="part_line_id"
                               domain="context.get('wof_default_film_id') and [('header_id', '=', context.get('wof_default_film_id'))] or []"/>
                        <field name="header_id" readonly="1"/>
                        <field name="car_part_id" readonly="1"/>
                        <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        <field name="car_size_id"/>
                        <field name="commission"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_film_parts_commission_lines" model="ir.actions.act_window">
        <field name="name">عمولات مكوّنات الخدمة</field>
        <field name="res_model">wof.film.parts.commission.lines</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_film_category_wo_v4" name="الخدمات والأفلام"
              parent="menu_wo_v4_configuration" action="action_film_category_wo_v4"
              sequence="20" groups="yousentech_wo_v4.group_wo_manager"/>
    <menuitem id="menu_film_parts_price_lines" name="الأسعار المتقدمة"
              parent="menu_wo_v4_configuration" action="action_film_parts_price_lines"
              sequence="31" groups="yousentech_wo_v4.group_wo_manager"/>
    <menuitem id="menu_film_parts_commission_lines" name="العمولات المتقدمة"
              parent="menu_wo_v4_configuration" action="action_film_parts_commission_lines"
              sequence="32" groups="yousentech_wo_v4.group_wo_manager"/>
</odoo>
