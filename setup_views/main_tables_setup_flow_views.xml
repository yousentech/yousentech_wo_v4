<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================================
         Main setup flow uses real master tables only.
         No temporary setup wizard tables are used in this flow.
         ========================================================= -->
    <record id="view_wof_system_settings_form_main_setup_buttons" model="ir.ui.view">
        <field name="name">wof.system.settings.form.main.setup.buttons</field>
        <field name="model">wof.system.settings</field>
        <field name="inherit_id" ref="yousentech_wo_v4.view_wof_system_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'o_wof_settings_tools')]" position="inside">
                <button name="action_setup_services" type="object" string="1. أنواع الخدمات" class="btn btn-primary"/>
                <button name="action_setup_parts" type="object" string="2. أجزاء الخدمة" class="btn btn-secondary"/>
                <button name="action_setup_tints" type="object" string="3. درجات اللون" class="btn btn-secondary"/>
                <button name="action_setup_sizes" type="object" string="4. أحجام السيارات" class="btn btn-secondary"/>
                <button name="action_finish_main_setup"
                        type="object"
                        string="اكتمال التهيئة"
                        class="btn btn-success"
                        confirm="سيتم اعتماد التهيئة الحالية من الجداول الرئيسية. هل تريد المتابعة؟"/>
            </xpath>
        </field>
    </record>

    <!-- =========================
         Step 1: Service Types
         ========================= -->
    <record id="view_wof_main_setup_service_tree" model="ir.ui.view">
        <field name="name">wof.service.type.main.setup.tree</field>
        <field name="model">wof.service.type</field>
        <field name="arch" type="xml">
            <tree string="1/4 تهيئة أنواع الخدمات" editable="bottom" create="1" delete="0" decoration-muted="not setup_enabled">
                <field name="sequence" widget="handle" optional="show"/>
                <field name="setup_enabled" string="تفعيل" widget="boolean_toggle"/>
                <field name="name" string="نوع الخدمة"/>
                <field name="code" string="الكود"/>
                <field name="service_options" string="محرك الخدمة"/>
                <field name="is_default_setup" string="افتراضي" readonly="1" optional="hide"/>
                <field name="company_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_wof_main_setup_service_form" model="ir.ui.view">
        <field name="name">wof.service.type.main.setup.form</field>
        <field name="model">wof.service.type</field>
        <field name="arch" type="xml">
            <form string="تهيئة نوع الخدمة" create="1" delete="0" class="o_wof_premium_settings">
                <sheet>
                    <div class="o_wof_settings_hero">
                        <div class="o_wof_hero_content">
                            <span class="o_wof_hero_badge">الخطوة 1 من 4</span>
                            <h1><field name="name" placeholder="نوع الخدمة" nolabel="1"/></h1>
                            <p>فعّل نوع الخدمة وعدّل الكود أو محرك الخدمة. البيانات تحفظ مباشرة في جدول أنواع الخدمات الرئيسي.</p>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="setup_enabled" widget="boolean_toggle" string="تفعيل"/>
                            <field name="code"/>
                            <field name="service_options"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="is_default_setup" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wof_main_setup_services" model="ir.actions.act_window">
        <field name="name">1/4 تهيئة أنواع الخدمات</field>
        <field name="res_model">wof.service.type</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_wof_main_setup_service_tree"/>
        <field name="domain">[('is_default_setup','=',True)]</field>
        <field name="context">{'create': True, 'delete': False, 'active_test': False, 'default_is_default_setup': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">فعّل أنواع الخدمات التي تريد استخدامها من الجداول الرئيسية.</p>
        </field>
    </record>

    <!-- =========================
         Step 2: Car/Service Parts
         ========================= -->
    <record id="view_wof_main_setup_parts_tree" model="ir.ui.view">
        <field name="name">wof.car.parts.main.setup.tree</field>
        <field name="model">wof.car.parts</field>
        <field name="arch" type="xml">
            <tree string="2/4 تهيئة أجزاء الخدمة" editable="bottom" create="1" delete="0" decoration-muted="not active">
                <field name="priority_part" string="الترتيب" widget="handle"/>
                <field name="active" string="تفعيل" widget="boolean_toggle"/>
                <field name="name" string="الجزء"/>
                <field name="code" string="الكود"/>
                <field name="service_type_id" string="نوع الخدمة" options="{'no_create': True}"/>
                <field name="part_type" string="نوع الجزء"/>
                <field name="commission" string="العمولة" optional="show"/>
                <field name="is_default_setup" string="افتراضي" readonly="1" optional="hide"/>
                <field name="company_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_wof_main_setup_parts_form" model="ir.ui.view">
        <field name="name">wof.car.parts.main.setup.form</field>
        <field name="model">wof.car.parts</field>
        <field name="arch" type="xml">
            <form string="تهيئة جزء الخدمة" create="1" delete="0" class="o_wof_premium_settings">
                <sheet>
                    <div class="o_wof_settings_hero">
                        <div class="o_wof_hero_content">
                            <span class="o_wof_hero_badge">الخطوة 2 من 4</span>
                            <h1><field name="name" placeholder="اسم الجزء" nolabel="1"/></h1>
                            <p>فعّل أجزاء السيارة ومناطق الخدمة ورتبها. البيانات تحفظ مباشرة في جدول الأجزاء الرئيسي.</p>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="active" widget="boolean_toggle" string="تفعيل"/>
                            <field name="code"/>
                            <field name="service_type_id" options="{'no_create': True}"/>
                            <field name="part_type"/>
                        </group>
                        <group>
                            <field name="priority_part"/>
                            <field name="commission"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="is_default_setup" readonly="1"/>
                        </group>
                    </group>
                    <group string="خيارات إضافية">
                        <field name="part_options_required"/>
                        <field name="film_category_readonly"/>
                        <field name="service_area_commission_method"/>
                    </group>
                    <group string="ملاحظات">
                        <field name="notes"/>
                        <field name="warning_msg"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wof_main_setup_parts" model="ir.actions.act_window">
        <field name="name">2/4 تهيئة أجزاء الخدمة</field>
        <field name="res_model">wof.car.parts</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_wof_main_setup_parts_tree"/>
        <field name="domain">[('is_default_setup','=',True)]</field>
        <field name="context">{'create': True, 'delete': False, 'active_test': False, 'default_is_default_setup': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">فعّل أجزاء السيارة ومناطق الخدمة ورتبها كما تريد.</p>
        </field>
    </record>

    <!-- =========================
         Step 3: Tint Degrees
         ========================= -->
    <record id="view_wof_main_setup_tint_tree" model="ir.ui.view">
        <field name="name">wof.tint.degree.main.setup.tree</field>
        <field name="model">wof.tint.degree</field>
        <field name="arch" type="xml">
            <tree string="3/4 تهيئة درجات اللون" editable="bottom" create="1" delete="0" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="active" string="تفعيل" widget="boolean_toggle"/>
                <field name="name" string="المسمى"/>
                <field name="value" string="القيمة"/>
                <field name="is_default_setup" string="افتراضي" readonly="1" optional="hide"/>
                <field name="company_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_wof_main_setup_tint_form" model="ir.ui.view">
        <field name="name">wof.tint.degree.main.setup.form</field>
        <field name="model">wof.tint.degree</field>
        <field name="arch" type="xml">
            <form string="تهيئة درجة اللون" create="1" delete="0" class="o_wof_premium_settings">
                <sheet>
                    <div class="o_wof_settings_hero">
                        <div class="o_wof_hero_content">
                            <span class="o_wof_hero_badge">الخطوة 3 من 4</span>
                            <h1><field name="display_name" readonly="1" nolabel="1"/></h1>
                            <p>فعّل درجات اللون المطلوبة وعدّل القيم والتسلسل. البيانات تحفظ مباشرة في جدول درجات اللون.</p>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="active" widget="boolean_toggle" string="تفعيل"/>
                            <field name="name"/>
                            <field name="value"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="is_default_setup" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wof_main_setup_tints" model="ir.actions.act_window">
        <field name="name">3/4 تهيئة درجات اللون</field>
        <field name="res_model">wof.tint.degree</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_wof_main_setup_tint_tree"/>
        <field name="domain">[('is_default_setup','=',True)]</field>
        <field name="context">{'create': True, 'delete': False, 'active_test': False, 'default_is_default_setup': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">فعّل درجات اللون المطلوبة وعدّل التسلسل والقيم.</p>
        </field>
    </record>

    <!-- =========================
         Step 4: Car Sizes
         ========================= -->
    <record id="view_wof_main_setup_size_tree" model="ir.ui.view">
        <field name="name">wof.car.size.main.setup.tree</field>
        <field name="model">wof.car.size</field>
        <field name="arch" type="xml">
            <tree string="4/4 تهيئة أحجام السيارات" editable="bottom" create="1" delete="0" decoration-muted="not active">
                <field name="active" string="تفعيل" widget="boolean_toggle"/>
                <field name="name" string="الحجم"/>
                <field name="is_default_setup" string="افتراضي" readonly="1" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_wof_main_setup_size_form" model="ir.ui.view">
        <field name="name">wof.car.size.main.setup.form</field>
        <field name="model">wof.car.size</field>
        <field name="arch" type="xml">
            <form string="تهيئة حجم السيارة" create="1" delete="0" class="o_wof_premium_settings">
                <sheet>
                    <div class="o_wof_settings_hero">
                        <div class="o_wof_hero_content">
                            <span class="o_wof_hero_badge">الخطوة 4 من 4</span>
                            <h1><field name="name" placeholder="حجم السيارة" nolabel="1"/></h1>
                            <p>فعّل أحجام السيارات التي تريد استخدامها. البيانات تحفظ مباشرة في جدول أحجام السيارات.</p>
                        </div>
                    </div>
                    <group>
                        <field name="active" widget="boolean_toggle" string="تفعيل"/>
                        <field name="is_default_setup" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wof_main_setup_sizes" model="ir.actions.act_window">
        <field name="name">4/4 تهيئة أحجام السيارات</field>
        <field name="res_model">wof.car.size</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_wof_main_setup_size_tree"/>
        <field name="domain">[('is_default_setup','=',True)]</field>
        <field name="context">{'create': True, 'delete': False, 'active_test': False, 'default_is_default_setup': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">فعّل أحجام السيارات المطلوبة ثم ارجع إلى الإعدادات واضغط اكتمال التهيئة.</p>
        </field>
    </record>

    <!-- Dedicated setup menus: real master tables only -->
    <menuitem id="menu_wof_main_setup_flow" name="تهيئة النظام" parent="menu_wo_v4_configuration" action="action_wof_system_settings_open" sequence="0"/>
    <menuitem id="menu_wof_main_setup_services" name="1. أنواع الخدمات" parent="menu_wof_main_setup_flow" action="action_wof_main_setup_services" sequence="10"/>
    <menuitem id="menu_wof_main_setup_parts" name="2. أجزاء الخدمة" parent="menu_wof_main_setup_flow" action="action_wof_main_setup_parts" sequence="20"/>
    <menuitem id="menu_wof_main_setup_tints" name="3. درجات اللون" parent="menu_wof_main_setup_flow" action="action_wof_main_setup_tints" sequence="30"/>
    <menuitem id="menu_wof_main_setup_sizes" name="4. أحجام السيارات" parent="menu_wof_main_setup_flow" action="action_wof_main_setup_sizes" sequence="40"/>

</odoo>
