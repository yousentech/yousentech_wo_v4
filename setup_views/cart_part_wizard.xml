<?xml version="1.0" encoding="UTF-8"?>
<odoo>
 
 

    <!-- ================= FORM VIEW ================= -->
    <record id="view_car_part_wizard_wo_v4_form" model="ir.ui.view">
        <field name="name">wof.car.part_wizard_wo_v4.form</field>
        <field name="model">wof.car.parts.wizard</field>
        <field name="arch" type="xml">

            <form string="إضافة جزء سيارة">

                <header>
                    <field name="progress" widget="progressbar"/>
                </header>

                <sheet>
                    <group>
                        <field name="step" widget="statusbar"/>
                    </group>
                   

                   <!-- STEP 1 -->
                    <group invisible="step != 'step1'">
                        <field name="name"/>
                        <field name="service_type_id"/>
                    </group>

                    <!-- STEP 2 -->
                    <group invisible="step != 'step2'">
                        <field name="commission"/>
                        <field name="default_qty"/>
                    </group>

                    <!-- STEP 3 -->
                    <group invisible="step != 'step3'">
                        <field name="price_line_ids">
                            <tree editable="bottom">
                                <field name="service_type_id"/>
                                <field name="part_price"/>
                            </tree>
                        </field>
                    </group>

                    <!-- STEP 4 -->
                    <group invisible="step != 'step4'">
                        <field name="size_line_ids">
                            <tree editable="bottom">
                                <field name="default_qty"/>
                                <field name="min_qty"/>
                                <field name="max_qty"/>
                            </tree>
                        </field>
                    </group>

                    <!-- REVIEW -->
                    <group invisible="step != 'review'">
                        <div class="alert alert-info">
                            راجع البيانات قبل الحفظ
                        </div>
                    </group>

                  

                </sheet>

                <footer>
                    <button name="action_prev" string="السابق" type="object"/>
                    <button name="action_next" string="التالي" type="object"/>
                    <button name="action_create_record"
                        string="إنشاء"
                        type="object"
                        class="btn-primary"
                        invisible="step != 'review'"/>
                    <button string="إلغاء" special="cancel"/>
                </footer>

            </form>

        </field>
    </record>


   


    <!-- ================= ACTION ================= -->
    <record id="action_car_part_wizard_wo_v4" model="ir.actions.act_window">
        <field name="name">جزء السيارة</field>
        <field name="res_model">wof.car.parts.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_car_part_wizard_wo_v4_form"/>
        <field name="target">current</field>

      
    </record>
 
 

    <menuitem id="menu_car_part_wizard_wo_v4"
              name="تهيئة أجزاء السيارات"
              parent="menu_wo_v4_configuration"
              action="action_car_part_wizard_wo_v4"
              sequence="35"/>
 

</odoo>