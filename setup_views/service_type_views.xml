<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================
            MENUS
    ========================== -->

    <menuitem id="menu_wo_v4"
              name="العناية بالسيارات"
              sequence="4"/>

    <menuitem id="menu_wo_v4_operation"
              name="العمليات"
              parent="menu_wo_v4"
              sequence="1"/>

    <menuitem id="menu_wo_v4_products"
              name="المنتجات"
              parent="menu_wo_v4"
              sequence="2"/>

    <menuitem id="menu_wo_v4_reports"
              name="التقارير"
              parent="menu_wo_v4"
              sequence="3"/>

    <menuitem id="menu_wo_v4_configuration"
              name="تهيئة النظام"
              parent="menu_wo_v4"
              sequence="4"
              groups="yousentech_wo_v4.group_wo_settings"/>


    <!-- =========================
            TREE VIEW
    ========================== -->

    <record id="view_service_type_wo_v4_tree" model="ir.ui.view">
        <field name="name">wof.service.type.tree</field>
        <field name="model">wof.service.type</field>
        <field name="arch" type="xml">
            <tree string="أنواع الخدمات"
                  decoration-muted="not active">

                <field name="code"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>

            </tree>
        </field>
    </record>


    <!-- =========================
            FORM VIEW
    ========================== -->

    <record id="view_service_type_wo_v4_form" model="ir.ui.view">
        <field name="name">wof.service.type.form</field>
        <field name="model">wof.service.type</field>
        <field name="arch" type="xml">

            <form string="نوع الخدمة">

                <sheet>

                    <!-- 🔴 Ribbon (Odoo 17 Correct) -->
                    <widget name="web_ribbon"
                            title="غير مفعل"
                            bg_color="bg-danger"
                            invisible="active"/>

                    <!-- 🔘 Button Box -->
                    <div class="oe_button_box" name="button_box">

                        <button name="toggle_active"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-power-off"
                                invisible="not id"
                                groups="yousentech_wo_v4.group_wo_manager">

                            <field name="active" widget="boolean_button"/>

                            <div class="o_stat_info">
                                <span class="o_stat_text">
                                    <field name="active"/>
                                </span>
                            </div>

                        </button>

                    </div>

                    <!-- 📋 Fields -->
                    <group>
                        <group>
                            <field name="code" placeholder="مثال: TINT"/>
                            <field name="name" placeholder="مثال: عزل حراري"/>
                        </group>

                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- =========================
            SEARCH VIEW
    ========================== -->

    
        <record id="view_work_order_search" model="ir.ui.view">
            <field name="name">oil.work.order.search</field>
            <field name="model">oil.work.order</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <search string="Work Order Search">
                   <field name="order_seq" />
                    <field name="mobile_number" string="Mobile Number" />
                    <field name="car_number" string="Car Number" />
                    <field name="car_letters" string="Car Letters" />
                    <field name="partner_id" string="Car Owner" />
                    <field name="employee_id" string="Employee" />
                    <field name="car_model" string="Car Model" />
                    <field name="car_version_id" string="Car Version" />
                    <field name="car_type_id" string="Car Type" />

                    <!-- External requests filter -->
                    <filter string="External Requests" name="external_requests"
                        domain="[('external_requests','=',True)]" />
                    <filter string="Internal Requests" name="internal_requests"
                        domain="[('external_requests','=',False)]" />

                    <filter string="Completed Orders" name="completed_orders"
                        domain="[('sale_order_id','!=',False)]" />
                  
                    <filter string="Un Completed Orders" name="un_completed_orders"
                        domain="[('sale_order_id','=',False)]" />

                    <!-- Grouping options -->
                    <filter string="By Employee" name="groupby_employee"
                        context="{'group_by':'employee_id'}" />
                    <filter string="By Car Type" name="groupby_car_type"
                        context="{'group_by':'car_type_id'}" />

                </search>
            </field>
        </record>



    <record id="view_service_type_wo_v4_search" model="ir.ui.view">
        <field name="name">wof.service.type.search</field>
        <field name="model">wof.service.type</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">

            <search string="بحث أنواع الخدمات">

                <!-- Search Fields -->
                <field name="name"/>
                <field name="code"/>

                <!-- Filters -->
                <filter string="المفعلة"
                        name="active"
                        domain="[('active','=',True)]"/>

                <filter string="غير المفعلة"
                        name="inactive"
                        domain="[('active','=',False)]"/>

             
                <!-- Group By -->
                

                    <filter string="الشركة" name="groupby_company"
                            context="{'group_by':'company_id'}"/>

                    <filter string="الحالة" name="groupby_state"
                            context="{'group_by':'active'}"/>

             

               <!-- <searchpanel>
                    <field name="company_id"/>
                
                </searchpanel>
               -->

            </search>

        </field>
    </record>


    <!-- =========================
            ACTION
    ========================== -->

    <record id="action_service_types_wo_v4" model="ir.actions.act_window">
        <field name="name">أنواع الخدمات</field>
        <field name="res_model">wof.service.type</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_service_type_wo_v4_search"/>
    </record>


    <!-- =========================
            MENU ACTION
    ========================== -->

    <menuitem id="menu_service_types_v4"
              name="أنواع الخدمات"
              parent="menu_wo_v4_configuration"
              action="action_service_types_wo_v4"
              sequence="10"/>

</odoo>