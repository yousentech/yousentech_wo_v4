<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_film_parts_lines_tint_policy" model="ir.ui.view">
        <field name="name">wof.film.parts.lines.tint.policy</field>
        <field name="model">wof.film.parts.lines</field>
        <field name="inherit_id" ref="yousentech_wo_v4.view_film_parts_wo_v4_lines_form"/>
        <field name="arch" type="xml">
            <!--
                Default tint grade belongs to the Basic Data card.
                Target the stable field name directly; Odoo 17 does not allow
                using @string as an inherited-view selector.
            -->
            <xpath expr="//field[@name='film_category_line_id']" position="attributes">
                <attribute name="string">درجة اللون الافتراضية</attribute>
                <attribute name="invisible">not supports_color_grades or part_type != 'car_part'</attribute>
                <attribute name="domain">[('header_id', '=', header_id), ('active', '=', True)]</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>

            <!--
                Allowed grades and their warning stay together below the basic
                data section. They are component-only and thermal-tint-only.
            -->
            <xpath expr="//notebook[@class='wof_service_notebook']/page[1]" position="after">
                <page string="تحذيرات العزل الحراري"
                      invisible="not supports_color_grades or part_type != 'car_part'">
                    <group col="2">
                        <field name="allowed_grade_ids"
                               string="درجات اللون المسموحة"
                               widget="many2many_tags"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="warning_msg"
                               string="رسالة التحذير"
                               placeholder="مثال: الدرجة المختارة غير مصرح بها مرورياً"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
