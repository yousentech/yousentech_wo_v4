<?xml version="1.0" encoding="UTF-8"?>
<odoo>

   

    <!-- =========================
            TREE VIEW
    ========================== -->

    <record id="view_service_type_wo_v4_tree" model="ir.ui.view">
        <field name="name">wof.service.type.tree</field>
        <field name="model">wof.service.type</field>
        <field name="arch" type="xml">
            <tree string="أنواع الخدمات" decoration-muted="not active">

                <field name="code"/>
                <field name="name"/>
                <field name="service_options" />
                <field name="setup_enabled" string="مفعلة" widget="boolean_toggle"/>

                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>

            </tree>
        </field>
    </record>

<!-- =========================
         KANBAN VIEW
    ========================== -->
    <record id="view_wof_service_type_wo_v4_kanban" model="ir.ui.view">
        <field name="name">wof.service.type.wo_v4.kanban</field>
        <field name="model">wof.service.type</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_large o_wof_service_setup_kanban" create="1" delete="0">

                <field name="name"/>
                <field name="code"/>
                <field name="service_options"/>
                <field name="setup_enabled"/>
                <field name="parts_count"/>
                <field name="film_count"/>
                <field name="active"/>
                <field name="company_id"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card p-3 rounded shadow-sm #{record.setup_enabled.raw_value ? 'border border-primary bg-primary-subtle' : 'border bg-white'} #{record.active.raw_value ? '' : 'o_kanban_record_inactive'}" style="min-height:245px;">

                            <!-- HEADER -->
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-bold text-dark" style="font-size:17px;">
                                        <i t-attf-class="fa me-1 #{record.setup_enabled.raw_value ? 'fa-check-circle text-success' : 'fa-circle-o text-muted'}" title="حالة التفعيل"/>
                                        <t t-if="record.code.raw_value">
                                            [<field name="code"/>]
                                        </t>
                                        <field name="name"/>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        <t t-if="record.service_options.raw_value">
                                            <i class="fa fa-cogs me-1" title="محرك الخدمة"/>
                                            <field name="service_options"/>
                                        </t>
                                        <t t-if="!record.service_options.raw_value">
                                            <i class="fa fa-layer-group me-1" title="خدمة عامة"/>
                                            خدمة عامة
                                        </t>
                                    </div>
                                </div>

                                <div class="text-end">
                                    <div class="text-muted small mb-1">تفعيل الخدمة</div>
                                    <field name="setup_enabled" widget="boolean_toggle"/>
                                </div>
                            </div>

                            <!-- STATUS -->
                            <div class="mt-3">
                                <span t-if="record.setup_enabled.raw_value and record.film_count.raw_value &gt; 0" class="badge bg-success px-3 py-2">
                                    <i class="fa fa-check-circle me-1" title="مهيأة"/>
                                    مهيأة
                                </span>
                                <span t-if="record.setup_enabled.raw_value and record.film_count.raw_value == 0" class="badge bg-primary px-3 py-2">
                                    جاهزة للتهيئة
                                </span>
                                <span t-if="!record.setup_enabled.raw_value" class="badge bg-secondary px-3 py-2">
                                    غير مفعلة
                                </span>
                            </div>

                            <!-- SUMMARY -->
                            <div class="row text-center mt-3 g-2">
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-white">
                                        <div class="fw-bold text-primary" style="font-size:18px;">
                                            <field name="film_count"/>
                                        </div>
                                        <div class="text-muted small">الأفلام</div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 bg-white">
                                        <div class="fw-bold text-success" style="font-size:18px;">
                                            <field name="parts_count"/>
                                        </div>
                                        <div class="text-muted small">الأجزاء</div>
                                    </div>
                                </div>
                            </div>

                            <!-- ACTIONS -->
                            <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center gap-2 flex-wrap">
                                <a type="object"
                                   name="action_start_configuration"
                                   class="btn btn-sm btn-primary"
                                   role="button">
                                    <i class="fa fa-play me-1" title="بدء"/>
                                    بدء التهيئة
                                </a>

                                <a type="object"
                                   name="action_open_details"
                                   class="btn btn-sm btn-outline-secondary"
                                   role="button">
                                    <i class="fa fa-info-circle me-1" title="تفاصيل"/>
                                    تفاصيل الخدمة
                                </a>
                            </div>

                            <!-- FOOTER -->
                            <div class="text-muted small mt-3">
                                <i class="fa fa-building-o me-1" title="الشركة"/>
                                <field name="company_id"/>
                            </div>

                        </div>
                    </t>
                </templates>

            </kanban>
        </field>
    </record>

    <!-- =========================
            FORM VIEW
    ========================== -->

    <record id="view_service_type_wo_v4_form" model="ir.ui.view">
        <field name="name">wof.service.type.form</field>
        <field name="model">wof.service.type</field>
        <field name="arch" type="xml">

            <form string="نوع الخدمة">
                <button name="action_create_film"  type="object"  string="إضافة فيلم"  class="btn btn-primary"   icon="fa-plus"/>


                <sheet> 
                    <widget name="web_ribbon"
                            title="مؤرشف"
                            bg_color="bg-danger"
                            invisible="active"/>

                    <!-- 🔘 Button Box -->
                    <div class="oe_button_box" name="button_box">
                    <button name="toggle_active"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-power-off"
                            invisible="not id"
                            groups="yousentech_wo_v4.group_wo_manager">

                        <field name="active"
                            widget="boolean_button"
                            options="{'terminology': 'archive'}"/>
                    </button>
                    <button name="action_open_films"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-film">

                        <field name="film_count"
                            string="الأفلام المرتبطة"
                            widget="statinfo"/>

                    </button>
 
                    </div>

                  
                    <group>
                        <group>
                            <field name="code" placeholder="مثال: TINT"/>
                            <field name="name" placeholder="مثال: عزل حراري"/>
                            
                        </group>

                        <group>

                            <field name="service_options" widget="radio"   options="{'horizontal': true}"/>
                            <field name="setup_enabled" widget="boolean_toggle" string="مفعلة في التهيئة"/>

                            <field name="company_id" groups="base.group_multi_company" readonly="1" force_save="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                   
                </sheet>
               
            </form>

        </field>
    </record>


    <!-- =========================
            SEARCH VIEW
    ========================== -->

     


    <record id="view_service_type_wo_v4_search" model="ir.ui.view">
        <field name="name">wof.service.type.search</field>
        <field name="model">wof.service.type</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">

            <search string="بحث أنواع الخدمات">

                <!-- Search Fields -->
                <field name="name"/>
                <field name="code"/>
                <field name="service_options" />
                <field name="setup_enabled"/>


               
                <filter string="مؤرشف"
                        name="inactive"
                        domain="[('active','=',False)]"/>
                <filter string="مفعلة في التهيئة"
                        name="setup_enabled"
                        domain="[('setup_enabled','=',True)]"/>
 
                

                    <filter string="الشركة" name="groupby_company"
                            context="{'group_by':'company_id'}"/>

                    <filter string="الحالة" name="groupby_state"
                            context="{'group_by':'active'}"/>
               <searchpanel>
                    <field name="company_id"/>
                </searchpanel>
              

            </search>

        </field>
    </record>


    <!-- =========================
            ACTION
    ========================== -->

    <record id="action_service_types_wo_v4" model="ir.actions.act_window">
        <field name="name">أنواع الخدمات</field>
        <field name="res_model">wof.service.type</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="view_wof_service_type_wo_v4_kanban"/>
        <field name="context">{}</field>
  
    </record>


    <!-- =========================
            MENU ACTION
    ========================== -->

    <menuitem id="menu_service_types_wo_v4"
              name="أنواع الخدمات"
              parent="menu_wo_v4_configuration"
              action="action_service_types_wo_v4"
              sequence="10"/>

</odoo>