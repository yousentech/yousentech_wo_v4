<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================
            MENUS
    ========================== -->

    <menuitem id="menu_wo_v4"
              name="العناية بالسيارات"
              sequence="4"/>

    <menuitem id="menu_wo_v4_operation"
              name="العمليات"
              parent="menu_wo_v4"
              sequence="1"/>

    <menuitem id="menu_wo_v4_products"
              name="المنتجات"
              parent="menu_wo_v4"
              sequence="2"/>

    <menuitem id="menu_wo_v4_reports"
              name="التقارير"
              parent="menu_wo_v4"
              sequence="3"/>

    <menuitem id="menu_wo_v4_configuration"
              name="تهيئة النظام"
              parent="menu_wo_v4"
              sequence="4"
              groups="yousentech_wo_v4.group_wo_settings"/>


    <!-- =========================
            TREE VIEW
    ========================== -->

    <record id="view_service_type_wo_v4_tree" model="ir.ui.view">
        <field name="name">wof.service.type.tree</field>
        <field name="model">wof.service.type</field>
        <field name="arch" type="xml">
            <tree string="أنواع الخدمات" decoration-muted="not active">

                <field name="code"/>
                <field name="name"/>
                <field name="heat_insulation" />

                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>

            </tree>
        </field>
    </record>

<!-- =========================
         KANBAN VIEW
    ========================== -->
    <record id="view_wof_service_type_wo_v4_kanban" model="ir.ui.view">
        <field name="name">wof.service.type.wo_v4.kanban</field>
        <field name="model">wof.service.type</field>
        <field name="arch" type="xml">
             <kanban class="o_kanban_large">

                <field name="name"/>
                <field name="code"/>
                <field name="parts_count"/>
                <field name="film_count"/>
                <field name="active"/>

                <templates>
                    <t t-name="kanban-box">

                        <!-- 🎨 ألوان حسب النشاط -->
                          <div t-attf-class="
                                oe_kanban_card oe_kanban_global_click p-3
                                    #{(record.parts_count.raw_value &gt; 0 and record.film_count.raw_value &gt; 0) ? 'border-start border-success border-4' : ''}
                                    #{((record.parts_count.raw_value &gt; 0 and record.film_count.raw_value == 0) or (record.parts_count.raw_value == 0 and record.film_count.raw_value &gt; 0)) ? 'border-start border-warning border-4' : ''}
                                    #{(record.parts_count.raw_value == 0 and record.film_count.raw_value == 0) ? 'border-start border-danger border-4' : ''}
                                    #{record.active.raw_value ? '' : 'o_kanban_record_inactive'}
                                ">

                            <!-- HEADER -->
                            <div class="mb-2">
                                <h4 class="mb-0">
                                    <t t-if="record.code.raw_value">
                                        [<field name="code"/>]
                                    </t>
                                    <field name="name"/>
                                </h4>
                            </div>

                            <hr/>

                             <!-- ================= COUNTERS ================= -->
                            <div class="row g-3 mt-1">

                                <!-- ================= PARTS ================= -->
                                <div class="col-6">

                                    <div t-attf-class="
                                        rounded-4 border p-3 bg-white shadow-sm service-box
                                        #{record.parts_count.raw_value > 0 ? 'border-success' : 'border-danger'}
                                    ">

                                        <!-- HEADER -->
                                        <div class="d-flex justify-content-between align-items-center">

                                            <div>
                                                <div class="fw-bold" style="font-size:15px;">
                                                    <i class="fa fa-cogs text-success me-1"></i>
                                                    الأجزاء
                                                </div>

                                                <small class="text-muted">
                                                    إدارة أجزاء الفيلم
                                                </small>
                                            </div>

                                            <!-- COUNT -->
                                            <div t-attf-class="
                                                rounded-circle d-flex align-items-center justify-content-center
                                                #{record.parts_count.raw_value > 0 ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger'}
                                            "
                                            style="width:58px;height:58px;font-size:18px;font-weight:bold;">

                                                <field name="parts_count"/>

                                            </div>

                                        </div>

                                        <!-- ACTIONS -->
                                        <div class="d-flex gap-2 mt-3">

                                            <!-- VIEW -->
                                            <a type="action"
                                            name="%(action_film_parts_wo_v4_lines)d"
                                            class="btn btn-outline-success btn-sm w-100"
                                            context="{
                                                    'search_default_service_type_id': active_id,
                                                    'search_default_group_by_header_id': 1
                                            }">

                                                <i class="fa fa-eye me-1"></i>
                                                عرض

                                            </a>

                                            <!-- CREATE -->
                                            <a type="action"
                                            name="%(action_film_parts_wo_v4_lines)d"
                                            class="btn btn-success btn-sm w-100"
                                            context="{
                                                    'default_service_type_id': active_id,
                                                    'form_view_initial_mode': 'edit'
                                            }">

                                                <i class="fa fa-plus me-1"></i>
                                                إضافة

                                            </a>

                                        </div>

                                    </div>

                                </div>

                                <!-- ================= FILMS ================= -->
                                <div class="col-6">

                                    <div t-attf-class="
                                        rounded-4 border p-3 bg-white shadow-sm service-box
                                        #{record.film_count.raw_value > 0 ? 'border-primary' : 'border-warning'}
                                    ">

                                        <!-- HEADER -->
                                        <div class="d-flex justify-content-between align-items-center">

                                            <div>
                                                <div class="fw-bold" style="font-size:15px;">
                                                    <i class="fa fa-film text-primary me-1"></i>
                                                    الأفلام
                                                </div>

                                                <small class="text-muted">
                                                    إدارة الأفلام
                                                </small>
                                            </div>

                                            <!-- COUNT -->
                                            <div t-attf-class="
                                                rounded-circle d-flex align-items-center justify-content-center
                                                #{record.film_count.raw_value > 0 ? 'bg-primary-subtle text-primary' : 'bg-warning-subtle text-warning'}
                                            "
                                            style="width:58px;height:58px;font-size:18px;font-weight:bold;">

                                                <field name="film_count"/>

                                            </div>

                                        </div>

                                        <!-- ACTIONS -->
                                        <div class="d-flex gap-2 mt-3">

                                            <!-- VIEW -->
                                            <a type="action"
                                            name="%(action_film_category_wo_v4)d"
                                            class="btn btn-outline-primary btn-sm w-100"
                                            context="{
                                                    'search_default_service_type_id': active_id
                                            }">

                                                <i class="fa fa-eye me-1"></i>
                                                عرض

                                            </a>

                                            <!-- CREATE -->
                                            <a type="object"
                                            name="action_create_film"
                                            class="btn btn-primary btn-sm w-100">

                                                <i class="fa fa-plus me-1"></i>
                                                إضافة

                                            </a>

                                        </div>

                                    </div>

                                </div>

                            </div>
                            <hr/>

                            <!-- FOOTER -->
                            <div class="text-muted">
                                <small>
                                    <field name="company_id"/>
                                </small>
                            </div>

                        </div>

                    </t>
                </templates>

            </kanban>
        </field>
    </record>

    <!-- =========================
            FORM VIEW
    ========================== -->

    <record id="view_service_type_wo_v4_form" model="ir.ui.view">
        <field name="name">wof.service.type.form</field>
        <field name="model">wof.service.type</field>
        <field name="arch" type="xml">

            <form string="نوع الخدمة">
                <button name="action_create_film"  type="object"  string="إضافة فيلم"  class="btn btn-primary"   icon="fa-plus"/>


                <sheet> 
                    <widget name="web_ribbon"
                            title="مؤرشف"
                            bg_color="bg-danger"
                            invisible="active"/>

                    <!-- 🔘 Button Box -->
                    <div class="oe_button_box" name="button_box">
                    <button name="toggle_active"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-power-off"
                            invisible="not id"
                            groups="yousentech_wo_v4.group_wo_manager">

                        <field name="active"
                            widget="boolean_button"
                            options="{'terminology': 'archive'}"/>
                    </button>
                    <button name="action_open_films"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-film">

                        <field name="film_count"
                            string="الأفلام المرتبطة"
                            widget="statinfo"/>

                    </button>
 
                    </div>

                  
                    <group>
                        <group>
                            <field name="code" placeholder="مثال: TINT"/>
                            <field name="name" placeholder="مثال: عزل حراري"/>
                            <field name="heat_insulation" />
                        </group>

                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="1" force_save="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                   
                </sheet>
               
            </form>

        </field>
    </record>


    <!-- =========================
            SEARCH VIEW
    ========================== -->

     


    <record id="view_service_type_wo_v4_search" model="ir.ui.view">
        <field name="name">wof.service.type.search</field>
        <field name="model">wof.service.type</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">

            <search string="بحث أنواع الخدمات">

                <!-- Search Fields -->
                <field name="name"/>
                <field name="code"/>
                <field name="heat_insulation" />


               
                <filter string="مؤرشف"
                        name="inactive"
                        domain="[('active','=',False)]"/>
 
                

                    <filter string="الشركة" name="groupby_company"
                            context="{'group_by':'company_id'}"/>

                    <filter string="الحالة" name="groupby_state"
                            context="{'group_by':'active'}"/>
               <searchpanel>
                    <field name="company_id"/>
                </searchpanel>
              

            </search>

        </field>
    </record>


    <!-- =========================
            ACTION
    ========================== -->

    <record id="action_service_types_wo_v4" model="ir.actions.act_window">
        <field name="name">أنواع الخدمات</field>
        <field name="res_model">wof.service.type</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="view_wof_service_type_wo_v4_kanban"/>
  
    </record>


    <!-- =========================
            MENU ACTION
    ========================== -->

    <menuitem id="menu_service_types_wo_v4"
              name="أنواع الخدمات"
              parent="menu_wo_v4_configuration"
              action="action_service_types_wo_v4"
              sequence="10"/>

</odoo>