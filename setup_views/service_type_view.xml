<?xml version="1.0" encoding="UTF-8"?>
<odoo>

   

    <!-- =========================
            TREE VIEW
    ========================== -->

    <record id="view_service_type_wo_v4_tree" model="ir.ui.view">
        <field name="name">wof.service.type.tree</field>
        <field name="model">wof.service.type</field>
        <field name="arch" type="xml">
            <tree string="أنواع الخدمات" decoration-muted="not active">

                <field name="code"/>
                <field name="name"/>
                <field name="service_options" />
                <field name="setup_enabled" string="مفعلة" widget="boolean_toggle"/>

                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="1"/>

            </tree>
        </field>
    </record>

<!-- =========================
         KANBAN VIEW
    ========================== -->
    <record id="view_wof_service_type_wo_v4_kanban" model="ir.ui.view">
        <field name="name">wof.service.type.wo_v4.kanban</field>
        <field name="model">wof.service.type</field>
        <field name="arch" type="xml">
            <kanban class="o_wof_service_setup_kanban o_wof_service_cards_clean" create="1" delete="0" sample="0">

                <field name="name"/>
                <field name="code"/>
                <field name="service_options"/>
                <field name="setup_enabled"/>
                <field name="active"/>
                <field name="company_id"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card o_wof_service_clean_card #{record.setup_enabled.raw_value ? 'o_wof_service_clean_card_enabled' : ''} #{record.active.raw_value ? '' : 'o_kanban_record_inactive'}" dir="rtl">

                            <div class="o_wof_service_clean_toggle" title="تفعيل الخدمة">
                                <field name="setup_enabled" widget="boolean_toggle"/>
                            </div>

                            <div class="o_wof_service_clean_head">
                                <span t-attf-class="o_wof_service_clean_state_dot #{record.setup_enabled.raw_value ? 'o_wof_service_clean_state_on' : ''}"/>
                                <div class="o_wof_service_clean_title">
                                    <field name="name"/>
                                </div>
                            </div>

                            <div class="o_wof_service_clean_body">
                                <div class="o_wof_service_clean_label">اسم الخدمة</div>
                                <div class="o_wof_service_clean_value">
                                    <field name="name"/>
                                </div>
                            </div>

                            <div class="o_wof_service_clean_edit">
                                <a type="object" name="action_open_details" title="تعديل الخدمة" role="button">
                                    <i class="fa fa-pencil"/>
                                </a>
                            </div>

                            <div class="o_wof_service_clean_footer">
                                <a type="object"
                                   name="action_start_configuration"
                                   class="btn btn-sm o_wof_btn_clean_start"
                                   role="button">
                                    بدء التهيئة
                                </a>
                                <a type="object"
                                   name="action_open_details"
                                   class="btn btn-sm o_wof_btn_clean_details"
                                   role="button">
                                    تفاصيل الخدمة
                                    <i class="fa fa-file-text-o"/>
                                </a>
                            </div>

                        </div>
                    </t>
                </templates>

            </kanban>
        </field>
    </record>

    <!-- =========================
            FORM VIEW
    ========================== -->

    <record id="view_service_type_wo_v4_form" model="ir.ui.view">
        <field name="name">wof.service.type.form</field>
        <field name="model">wof.service.type</field>
        <field name="arch" type="xml">

            <form string="نوع الخدمة">
                <button name="action_create_film"  type="object"  string="إضافة فيلم"  class="btn btn-primary"   icon="fa-plus"/>


                <sheet> 
                    <widget name="web_ribbon"
                            title="مؤرشف"
                            bg_color="bg-danger"
                            invisible="active"/>

                    <!-- 🔘 Button Box -->
                    <div class="oe_button_box" name="button_box">
                    <button name="toggle_active"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-power-off"
                            invisible="not id"
                            groups="yousentech_wo_v4.group_wo_manager">

                        <field name="active"
                            widget="boolean_button"
                            options="{'terminology': 'archive'}"/>
                    </button>
                    <button name="action_open_films"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-film">

                        <field name="film_count"
                            string="الأفلام المرتبطة"
                            widget="statinfo"/>

                    </button>
 
                    </div>

                  
                    <group>
                        <group>
                            <field name="code" placeholder="مثال: TINT"/>
                            <field name="name" placeholder="مثال: عزل حراري"/>
                            
                        </group>

                        <group>

                            <field name="service_options" widget="radio"   options="{'horizontal': true}"/>
                            <field name="setup_enabled" widget="boolean_toggle" string="مفعلة في التهيئة"/>

                            <field name="company_id" groups="base.group_multi_company" readonly="1" force_save="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                   
                </sheet>
               
            </form>

        </field>
    </record>


    <!-- =========================
            SEARCH VIEW
    ========================== -->

     


    <record id="view_service_type_wo_v4_search" model="ir.ui.view">
        <field name="name">wof.service.type.search</field>
        <field name="model">wof.service.type</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">

            <search string="بحث أنواع الخدمات">

                <!-- Search Fields -->
                <field name="name"/>
                <field name="code"/>
                <field name="service_options" />
                <field name="setup_enabled"/>


               
                <filter string="مؤرشف"
                        name="inactive"
                        domain="[('active','=',False)]"/>
                <filter string="مفعلة في التهيئة"
                        name="setup_enabled"
                        domain="[('setup_enabled','=',True)]"/>
 
                

                    <filter string="الشركة" name="groupby_company"
                            context="{'group_by':'company_id'}"/>

                    <filter string="الحالة" name="groupby_state"
                            context="{'group_by':'active'}"/>

            </search>

        </field>
    </record>


    <!-- =========================
            ACTION
    ========================== -->

    <record id="action_service_types_wo_v4" model="ir.actions.act_window">
        <field name="name">تهيئة أنواع الخدمات</field>
        <field name="res_model">wof.service.type</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="view_wof_service_type_wo_v4_kanban"/>
        <field name="context">{}</field>
  
    </record>


    <!-- =========================
            MENU ACTION
    ========================== -->

    <menuitem id="menu_service_types_wo_v4"
              name="أنواع الخدمات"
              parent="menu_wo_v4_configuration"
              action="action_service_types_wo_v4"
              sequence="10"/>

</odoo>