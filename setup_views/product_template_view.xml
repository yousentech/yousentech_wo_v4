<?xml version="1.0" encoding="UTF-8"?>
<odoo>
        <record id="product_template_wo_v4" model="ir.ui.view">
            <field name="name">product.template.wo_v4</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view" />
            <field name="arch" type="xml">
                <notebook>
                        <page string="نظام تركيب الافلام">
                            <group>
                                <group>
                                     <field name="measure_product"/>
                                 </group>
                                    
                            </group>
                        
                             
                        </page>
                </notebook>
            </field>
	    </record>
      
        <record id="action_product_template_wo_v4_view" model="ir.actions.act_window">
            <field name="name">المنتجات</field>
            <field name="res_model">product.template</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">kanban,form</field>
            <field name="view_id" ref="product.product_template_kanban_view"/>
            <field name="target">current</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Click to create new product
                </p>
            </field>
        </record>
            <menuitem id="product_templete_wo_v4_menu" name="المنتجات" sequence="1"  parent="menu_wo_v4_products"
                            action="action_product_template_wo_v4_view"/>
</odoo>