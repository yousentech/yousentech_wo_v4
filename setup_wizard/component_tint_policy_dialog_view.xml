<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wof_component_create_dialog_tint_policy" model="ir.ui.view">
        <field name="name">wof.film.setup.component.create.dialog.tint.policy</field>
        <field name="model">wof.film.setup.component.create.dialog</field>
        <field name="inherit_id" ref="yousentech_wo_v4.view_wof_film_setup_component_create_dialog_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='edit_line_id']" position="after">
                <field name="film_id" invisible="1"/>
                <field name="show_tint_policy" invisible="1"/>
            </xpath>

            <!--
                Keep all Basic Data fields in one grid.  The default tint field is
                conditionally hidden for non-thermal/service-area records, so the
                original three-field layout remains intact there.  For thermal car
                parts it becomes the fourth field instead of creating a second row.
            -->
            <xpath expr="//div[contains(@class, 'wof_component_create_identity_grid')]" position="replace">
                <div class="wof_component_create_identity_grid">
                    <div class="wof_component_create_field is-name">
                        <span class="o_form_label">اسم المكوّن / المنطقة <b>*</b></span>
                        <field name="name" placeholder="مثال: الزجاج الأمامي"/>
                    </div>
                    <div class="wof_component_create_field is-default-tint" invisible="not show_tint_policy">
                        <span class="o_form_label">درجة اللون الافتراضية</span>
                        <div class="wof_component_product_field">
                            <field name="default_tint_grade_id"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   placeholder="اختر درجة اللون الافتراضية"/>
                        </div>
                    </div>
                    <div class="wof_component_create_field is-code">
                        <span class="o_form_label">الكود <em>اختياري</em> <small>(يُولّد تلقائيًا عند تركه فارغًا)</small></span>
                        <field name="code" placeholder="تلقائي"/>
                    </div>
                    <div class="wof_component_create_field is-priority">
                        <span class="o_form_label">ترتيب الأولوية</span>
                        <field name="priority_part"/>
                    </div>
                </div>
            </xpath>

            <!-- Thermal-film component layout: remove notes and align allowed grades with warning message. -->
            <xpath expr="//div[contains(@class, 'wof_component_create_grid') and contains(@class, 'is-notes-grid')]" position="replace">
                <div class="wof_component_create_grid is-notes-grid" invisible="show_tint_policy">
                    <div class="wof_component_create_field">
                        <span class="o_form_label">ملاحظات</span>
                        <field name="notes" placeholder="ملاحظة داخلية اختيارية"/>
                    </div>
                    <div class="wof_component_create_field">
                        <span class="o_form_label">رسالة تحذير</span>
                        <field name="warning_msg" placeholder="تظهر عند الحاجة أثناء التشغيل"/>
                    </div>
                </div>
                <div class="wof_component_create_grid is-notes-grid wof_tint_policy_row" invisible="not show_tint_policy">
                    <div class="wof_component_create_field is-allowed-tints">
                        <span class="o_form_label">درجات اللون المسموحة</span>
                        <div class="wof_component_product_field">
                            <field name="allowed_tint_grade_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   placeholder="حدد الدرجات المسموحة لهذا المكوّن"/>
                        </div>
                    </div>
                    <div class="wof_component_create_field is-warning-message">
                        <span class="o_form_label">رسالة تحذير</span>
                        <div class="wof_component_product_field">
                            <field name="warning_msg" placeholder="تظهر عند الحاجة أثناء التشغيل"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
