<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form_wo_v4"
            model="ir.ui.view">

        <field name="name">
            res.config.settings.view.form.wo.v4
        </field>

        <field name="model">
            res.config.settings
        </field>

        <field name="inherit_id"
               ref="base_setup.res_config_settings_view_form"/>

        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <app string="العناية بالسيارات"
                     name="wo_v4">

                    <block title="تهيئة النظام">

                        <setting string="تمت التهيئة">

                            <div class="d-flex align-items-center gap-3">

                                <!-- FLAG -->
                                <field name="wo_setup_completed"/>

                                <!-- BUTTON -->
                                <button string="إعادة التهيئة"
                                        type="object"
                                        name="action_re_setup_wo_v4"
                                        class="btn btn-secondary"
                                        groups="yousentech_wo_v4.group_wo_settings"/>

                            </div>

                        </setting>

                    </block>

                </app>

            </xpath>

        </field>

    </record>

</odoo>