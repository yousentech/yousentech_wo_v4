<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wof_film_setup_component_dialog_bulk" model="ir.ui.view">
        <field name="name">wof.film.setup.component.dialog.bulk</field>
        <field name="model">wof.film.setup.component.dialog</field>
        <field name="inherit_id" ref="yousentech_wo_v4.view_wof_film_setup_component_dialog_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'wof_component_dialog_field')]" position="replace">
                <div class="wof_component_dialog_field">
                    <div class="wof_component_dialog_field_head">
                        <label for="selected_part_ids" string="المكونات المتاحة" invisible="line_id"/>
                        <label for="car_part_id" string="المكوّن" invisible="not line_id"/>
                        <span invisible="line_id or expected_type != 'car_part'">حدد جزءًا واحدًا أو عدة أجزاء لإضافتها دفعة واحدة</span>
                        <span invisible="line_id or expected_type != 'service_area'">حدد منطقة خدمة واحدة أو عدة مناطق لإضافتها دفعة واحدة</span>
                        <span invisible="not line_id">اختر المكوّن البديل للسجل الحالي</span>
                    </div>
                    <field name="selected_part_ids"
                           widget="many2many_checkboxes"
                           nolabel="1"
                           invisible="line_id"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="car_part_id"
                           invisible="not line_id"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </div>
            </xpath>
            <xpath expr="//footer/button[@name='action_confirm'][not(@invisible)]" position="attributes">
                <attribute name="string">إضافة المحدد</attribute>
            </xpath>
        </field>
    </record>
</odoo>
