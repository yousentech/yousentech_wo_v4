<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wof_activity_hub_form" model="ir.ui.view">
        <field name="name">wof.activity.hub.form</field>
        <field name="model">wof.activity.hub</field>
        <field name="arch" type="xml">
            <form string="الأنشطة المفعلة" class="wof_activity_hub_form" create="0" edit="0" delete="0">
                <field name="profile_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="view_state" invisible="1"/>
                <field name="selected_activity_id" invisible="1"/>
                <field name="activity_count" invisible="1"/>
                <field name="film_count" invisible="1"/>

                <div class="wof_hub_shell">
                    <div class="wof_hub_header">
                        <div class="wof_hub_header_icon"><i class="fa fa-th-large" title="الأنشطة"/></div>
                        <h1 invisible="view_state != 'activities'">الأنشطة المفعلة</h1>
                        <h1 invisible="view_state != 'films'">أفلام وخدمات <field name="selected_activity_id" readonly="1"/></h1>
                        <p invisible="view_state != 'activities'">
                            اختر النشاط الذي تريد إضافة أفلامه وخدماته أو متابعة تهيئته.
                        </p>
                        <p invisible="view_state != 'films'">
                            أضف الأفلام والخدمات التي يقدمها هذا النشاط، ثم قم بتهيئة المكونات والأسعار لكل نوع.
                        </p>
                        <div class="wof_hub_context" invisible="view_state != 'activities'">
                            <span><i class="fa fa-building-o" title="الشركة"/> <field name="company_id" readonly="1"/></span>
                            <span><field name="activity_count" readonly="1"/> أنشطة مفعلة</span>
                        </div>
                        <div class="wof_hub_context" invisible="view_state != 'films'">
                            <span>النشاط: <field name="selected_activity_id" readonly="1"/></span>
                            <span><field name="film_count" readonly="1"/> عناصر</span>
                        </div>
                    </div>

                    <div class="wof_hub_content" invisible="view_state != 'activities'">
                        <div class="wof_hub_section_heading">
                            <div>
                                <h2>اختر النشاط</h2>
                                <p>كل نشاط يفتح لك أفلامه وخدماته داخل نفس تجربة التهيئة.</p>
                            </div>
                        </div>
                        <field name="activity_line_ids" nolabel="1" class="wof_hub_x2many">
                            <kanban create="0" edit="0" delete="0" class="wof_hub_activity_kanban">
                                <field name="name"/>
                                <field name="description"/>
                                <field name="supports_color_grades"/>
                                <field name="film_count"/>
                                <field name="parts_count"/>
                                <field name="active"/>
                                <templates>
                                    <t t-name="kanban-box">
                                        <div class="wof_hub_activity_card">
                                            <div class="wof_hub_activity_top">
                                                <span t-if="record.supports_color_grades.raw_value" class="wof_hub_activity_icon tint">
                                                    <i class="fa fa-sun-o" title="عزل حراري"/>
                                                </span>
                                                <span t-else="" class="wof_hub_activity_icon general">
                                                    <i class="fa fa-th-large" title="نشاط عام"/>
                                                </span>
                                                <div class="wof_hub_activity_identity">
                                                    <strong><field name="name"/></strong>
                                                    <span class="wof_hub_status"><i class="fa fa-check-circle" title="مفعّل"/> مفعّل</span>
                                                </div>
                                            </div>
                                            <p class="wof_hub_activity_desc">
                                                <t t-if="record.description.raw_value"><field name="description"/></t>
                                                <t t-else="">أضف الأفلام والخدمات ثم أكمل مكوناتها وتسعيرها.</t>
                                            </p>
                                            <div class="wof_hub_activity_stats">
                                                <div class="wof_hub_stat">
                                                    <strong><field name="film_count"/></strong>
                                                    <span>أفلام / خدمات</span>
                                                </div>
                                                <div class="wof_hub_stat">
                                                    <strong><field name="parts_count"/></strong>
                                                    <span>مكوّن</span>
                                                </div>
                                                <div class="wof_hub_stat">
                                                    <strong t-if="record.supports_color_grades.raw_value"><i class="fa fa-tint" title="درجات اللون"/></strong>
                                                    <strong t-else="">—</strong>
                                                    <span>درجات اللون</span>
                                                </div>
                                            </div>
                                            <button name="action_open_films" type="object"
                                                    class="btn btn-primary wof_hub_primary_btn">
                                                إدارة الأفلام والخدمات
                                                <i class="fa fa-arrow-left" title="فتح"/>
                                            </button>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                        <div class="wof_hub_empty" invisible="activity_count != 0">
                            <i class="fa fa-info-circle" title="معلومة"/>
                            <strong>لا توجد أنشطة مفعلة.</strong>
                            <span>ارجع إلى مركز التهيئة وفعّل نشاطًا واحدًا على الأقل.</span>
                        </div>
                    </div>

                    <div class="wof_hub_content" invisible="view_state != 'films'">
                        <div class="wof_hub_section_heading wof_hub_films_toolbar">
                            <div>
                                <h2>أفلام وخدمات النشاط</h2>
                                <p>راجع حالة كل عنصر وابدأ تهيئته عند الحاجة.</p>
                            </div>
                            <button name="action_add_film" type="object" class="btn btn-primary wof_hub_add_btn">
                                <i class="fa fa-plus" title="إضافة"/> إضافة فيلم / خدمة
                            </button>
                        </div>
                        <field name="film_line_ids" nolabel="1" class="wof_hub_x2many">
                            <kanban create="0" edit="0" delete="0" class="wof_hub_film_kanban">
                                <field name="name"/><field name="item_type"/><field name="active"/>
                                <field name="configuration_ready"/><field name="configuration_note"/>
                                <field name="parts_count"/><field name="grade_count"/><field name="car_size_count"/>
                                <field name="pricing_summary"/><field name="supports_color_grades"/>
                                <templates>
                                    <t t-name="kanban-box">
                                        <div t-attf-class="wof_hub_film_card #{record.active.raw_value ? '' : 'inactive'}">
                                            <div class="wof_hub_film_head">
                                                <div>
                                                    <strong><field name="name"/></strong>
                                                    <div class="wof_hub_film_badges">
                                                        <span class="kind"><field name="item_type"/></span>
                                                        <span t-if="record.active.raw_value" class="active"><i class="fa fa-check-circle" title="مفعّل"/> مفعّل</span>
                                                        <span t-else="" class="muted"><i class="fa fa-times-circle" title="غير مفعّل"/> غير مفعّل</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="wof_hub_film_body">
                                                <div t-if="record.configuration_ready.raw_value" class="wof_hub_ready"><i class="fa fa-check-circle" title="جاهز"/> جاهز</div>
                                                <div t-else="" class="wof_hub_not_ready"><i class="fa fa-exclamation-triangle" title="يحتاج إلى تهيئة"/> يحتاج إلى تهيئة</div>
                                                <small t-if="!record.configuration_ready.raw_value"><field name="configuration_note"/></small>
                                                <div class="wof_hub_film_metrics">
                                                    <span><b><field name="parts_count"/></b> مكونات</span>
                                                    <span t-if="record.car_size_count.raw_value"><b><field name="car_size_count"/></b> أحجام سيارات</span>
                                                    <span t-if="record.supports_color_grades.raw_value"><b><field name="grade_count"/></b> درجات لون</span>
                                                </div>
                                                <div class="wof_hub_pricing"><span>سياسة التسعير</span><strong><field name="pricing_summary"/></strong></div>
                                            </div>
                                            <button name="action_configure" type="object" class="btn btn-primary wof_hub_primary_btn">تهيئة</button>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                        <div class="wof_hub_empty" invisible="film_count != 0">
                            <i class="fa fa-film" title="الأفلام والخدمات"/>
                            <strong>لا توجد أفلام أو خدمات لهذا النشاط بعد.</strong>
                            <span>ابدأ بإضافة أول فيلم أو خدمة.</span>
                        </div>
                    </div>
                </div>

                <footer class="wof_hub_footer">
                    <button name="action_back_to_activities" type="object" string="السابق: الأنشطة"
                            class="btn-secondary" invisible="view_state != 'films'" icon="fa-arrow-right"/>
                    <button string="إغلاق" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
