<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_wof_setup_wizard_form" model="ir.ui.view">
        <field name="name">wof.setup.wizard.form</field>
        <field name="model">wof.setup.wizard</field>
        <field name="arch" type="xml">

            <form string="تهيئة النظام" create="0" edit="1">
                <sheet>

                    <field name="step" invisible="1"/>
                    <field name="current_service_index" invisible="1"/>
                    <field name="current_service_line_id" invisible="1"/>

                    <!-- WELCOME -->
                    <div invisible="step != 'welcome'">

                        <div class="alert alert-primary text-center p-4">
                            <h1>
                                <i class="fa fa-magic me-2"/>
                                مرحباً بك في نظام العناية بالسيارات
                            </h1>

                            <div class="text-muted mt-2">
                                سنقوم بتهيئة النظام خطوة بخطوة.
                            </div>
                        </div>

                    </div>

                    <!-- SERVICE TYPES -->
                    <div invisible="step != 'service_types'">

                        <div class="alert alert-info text-center p-3">
                            <h3>
                                <i class="fa fa-cogs me-2"/>
                                تهيئة أنواع الخدمات
                            </h3>

                            <div class="text-muted">
                                اختر الخدمات المطلوبة واكتب الاسم الذي سيظهر في النظام.
                            </div>
                        </div>

                        <field name="service_line_ids" nolabel="1">
                            <kanban create="0" delete="0" class="o_kanban_small_column">

                                <field name="selected"/>
                                <field name="service_options"/>
                                <field name="custom_name"/>

                                <templates>
                                    <t t-name="kanban-box">

                                        <div t-attf-class="
                                            oe_kanban_card p-3 rounded shadow-sm
                                            #{record.selected.raw_value ? 'border border-success bg-success-subtle' : 'border bg-white'}
                                        ">

                                            <div class="d-flex justify-content-between align-items-center">

                                                <div class="fw-bold" style="font-size:16px;">
                                                    <i class="fa fa-check-circle text-success me-1"
                                                       invisible="not selected"/>

                                                    <field name="service_options"/>
                                                </div>

                                                <field name="selected" widget="boolean_toggle"/>

                                            </div>

                                            <div class="mt-3">

                                                <div class="text-muted small o_form_label">
                                                    اسم الخدمة
                                                </div>

                                                <div class="d-flex align-items-center justify-content-between">

                                                    <div class="fw-bold text-dark"
                                                         style="font-size:15px;">
                                                        <field name="custom_name"/>
                                                    </div>

                                                    <a type="object"
                                                       name="action_open_line"
                                                       class="text-primary ms-2"
                                                       title="تعديل الاسم">

                                                        <i class="fa fa-pencil"/>

                                                    </a>

                                                </div>

                                            </div>

                                        </div>

                                    </t>
                                </templates>

                            </kanban>
                        </field>

                    </div>

                    <!-- FILMS -->
                    <div invisible="step != 'films'">

                        <div class="alert alert-success text-center p-3">
                            <h3>
                                <i class="fa fa-film me-2"/>
                                تهيئة الأفلام
                            </h3>

                            <div class="text-muted">
                                أضف أفلام كل نوع خدمة على حدة.
                            </div>
                        </div>

                        <!-- SELECTED SERVICES -->
                        <div class="mb-3">

                            <div class="text-muted small o_form_label">
                                الخدمات المختارة
                            </div>

                            <field name="service_line_ids"
                                   nolabel="1"
                                   domain="[('selected','=',True)]">

                                <kanban create="0" delete="0" class="o_kanban_small_column">

                                    <field name="selected"/>
                                    <field name="custom_name"/>

                                    <templates>
                                        <t t-name="kanban-box">

                                            <div t-attf-class="
                                                oe_kanban_card p-2 rounded border
                                                #{record.id.raw_value == parent.current_service_line_id.raw_value ? 'bg-primary-subtle border-primary' : 'bg-light'}
                                            ">

                                                <i class="fa fa-check-circle text-success me-1"/>
                                                <field name="custom_name"/>

                                            </div>

                                        </t>
                                    </templates>

                                </kanban>

                            </field>

                        </div>

                        <!-- CURRENT SERVICE -->
                        <div class="alert alert-primary">

                            <strong>
                                <i class="fa fa-cogs me-1"/>
                                الخدمة الحالية:
                            </strong>

                            <field name="current_service_name"/>

                        </div>

                        <!-- ADD FILM -->
                        <div class="mb-3">

                            <button string="إضافة فيلم"
                                    type="object"
                                    name="action_add_film_line"
                                    class="btn btn-success"/>

                        </div>

                        <!-- FILMS ONLY FOR CURRENT SERVICE -->
                        <field name="film_line_ids"
                               nolabel="1"
                               domain="[('service_line_id','=',current_service_line_id)]">

                            <tree editable="bottom" create="0" delete="1">

                                <field name="selected"/>
                                <field name="service_name" readonly="1"/>
                                <field name="film_name"/>
                                <field name="warranty_years"/>

                            </tree>

                        </field>

                    </div>

                    <!-- ACTION BUTTONS -->
                    <div class="mt-4 pt-3 border-top d-flex justify-content-start gap-2">

                        <button string="بدء التهيئة"
                                type="object"
                                name="action_start_setup"
                                class="btn btn-primary btn-lg"
                                invisible="step != 'welcome'"/>

                        <button string="رجوع"
                                type="object"
                                name="action_back_welcome"
                                class="btn btn-secondary"
                                invisible="step != 'service_types'"/>

                        <button string="التالي: الأفلام"
                                type="object"
                                name="action_go_films"
                                class="btn btn-primary"
                                invisible="step != 'service_types'"/>

                        <button string="رجوع"
                                type="object"
                                name="action_back_service_types"
                                class="btn btn-secondary"
                                invisible="step != 'films'"/>

                        <button string="إضافة أفلام للنوع التالي"
                                type="object"
                                name="action_next_service_film"
                                class="btn btn-primary"
                                invisible="step != 'films'"/>

                        <button string="إضافة الأجزاء"
                                type="object"
                                name="action_go_parts"
                                class="btn btn-success"
                                invisible="step != 'films'"/>

                    </div>

                </sheet>
            </form>

        </field>
    </record>

    <!-- SERVICE LINE FORM -->
    <record id="view_wof_setup_service_line_form" model="ir.ui.view">
        <field name="name">wof.setup.service.line.form</field>
        <field name="model">wof.setup.wizard.service.line</field>
        <field name="arch" type="xml">

            <form string="تعديل الخدمة">
                <sheet>

                    <group>
                        <field name="selected"/>
                        <field name="service_options" readonly="1"/>
                        <field name="custom_name"/>
                    </group>

                    <footer>
                        <button string="حفظ"
                                special="save"
                                class="btn-primary"/>

                        <button string="إلغاء"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>

                </sheet>
            </form>

        </field>
    </record>

    <record id="action_wof_setup_wizard" model="ir.actions.act_window">
        <field name="name">تهيئة النظام</field>
        <field name="res_model">wof.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>