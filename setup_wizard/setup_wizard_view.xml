<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_wof_setup_wizard_form" model="ir.ui.view">
        <field name="name">wof.setup.wizard.form</field>
        <field name="model">wof.setup.wizard</field>
        <field name="arch" type="xml">

            <form string="تهيئة النظام" create="0" edit="1">
                <sheet>

                    <field name="step" invisible="1"/>

                    <!-- WELCOME -->
                    <div invisible="step != 'welcome'">

                        <div class="alert alert-primary text-center p-4">
                            <h1>
                                <i class="fa fa-magic me-2"/>
                                مرحباً بك في نظام العناية بالسيارات
                            </h1>

                            <div class="text-muted mt-2">
                                سنقوم بتهيئة النظام خطوة بخطوة.
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <button string="بدء التهيئة"
                                    type="object"
                                    name="action_start_setup"
                                    class="btn btn-primary btn-lg"/>
                        </div>

                    </div>

                    <!-- SERVICE TYPES -->
                    <div invisible="step != 'service_types'">

                        <div class="alert alert-info text-center p-3">
                            <h3>
                                <i class="fa fa-cogs me-2"/>
                                تهيئة أنواع الخدمات
                            </h3>

                            <div class="text-muted">
                                اختر الخدمات المطلوبة واكتب الاسم الذي سيظهر في النظام.
                            </div>
                        </div>
                     
                        <field name="service_line_ids" nolabel="1">
                            <kanban create="0" delete="0" class="o_kanban_small_column">

                                <field name="selected"/>
                                <field name="service_options"/>
                                <field name="custom_name"/>

                                <templates>
                                    <t t-name="kanban-box">

                                        <div t-attf-class="
                                            oe_kanban_card p-3 rounded shadow-sm
                                            #{record.selected.raw_value ? 'border border-success bg-success-subtle' : 'border bg-white'}
                                        ">

                                            <div class="d-flex justify-content-between align-items-center">

                                                <div class="fw-bold" style="font-size:16px;">
                                                    <i class="fa fa-check-circle text-success me-1"
                                                       invisible="not selected"/>

                                                    <field name="service_options"/>
                                                </div>

                                                <field name="selected" widget="boolean_toggle"/>

                                            </div>

                                          <div class="mt-3">

                                                <div class="text-muted small o_form_label">
                                                    اسم الخدمة
                                                </div>

                                                <div class="d-flex align-items-center justify-content-between">

                                                    <!-- NAME -->
                                                    <div class="fw-bold text-dark"
                                                        style="font-size:15px;">

                                                        <field name="custom_name"/>

                                                    </div>

                                                    <!-- EDIT ICON -->
                                                    <a type="object"
                                                    name="action_open_line"
                                                    class="text-primary ms-2"
                                                    title="تعديل الاسم">

                                                        <i class="fa fa-pencil"/>

                                                    </a>

                                                </div>

                                            </div>
                                        </div>

                                    </t>
                                </templates>

                            </kanban>
                        </field>

                         

                    </div>

                </sheet>
                <!-- ================= FOOTERS ================= -->

               <footer>

    <!-- START -->
    <button string="بدء التهيئة"
            type="object"
            name="action_start_setup"
            class="btn btn-primary btn-lg"
            invisible="step != 'welcome'"/>

    <!-- BACK -->
    <button string="رجوع"
            type="object"
            name="action_back_welcome"
            class="btn btn-secondary"
            invisible="step != 'service_types'"/>

    <!-- FINISH -->
    <button string="إنهاء التهيئة"
            type="object"
            name="action_finish_setup"
            class="btn btn-primary"
            invisible="step != 'service_types'"/>

</footer>
            </form>

        </field>
    </record>

    <!-- =========================
        SERVICE LINE FORM
    ========================= -->

    <record id="view_wof_setup_service_line_form"  model="ir.ui.view">
        <field name="name">wof.setup.service.line.form</field>
        <field name="model">wof.setup.wizard.service.line</field>
        <field name="arch" type="xml">
            <form string="تعديل الخدمة">
                <sheet>
                    <group>
                        <field name="selected"/>
                        <field name="service_options"
                            readonly="1"/>
                        <field name="custom_name"/>
                    </group>
                    <footer>
                        <button string="حفظ"
                                special="save"
                                class="btn-primary"/>
                        <button string="إلغاء"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_wof_setup_wizard" model="ir.actions.act_window">
        <field name="name">تهيئة النظام</field>
        <field name="res_model">wof.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

</odoo>