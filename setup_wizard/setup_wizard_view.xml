<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================
            FORM
    ========================== -->

    <record id="view_wof_setup_wizard_form" model="ir.ui.view">
        <field name="name">wof.setup.wizard.form</field>
        <field name="model">wof.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="تهيئة النظام"
                  create="0"
                  edit="0">

                <sheet>

                    <div class="alert alert-primary text-center">

                        <h1>
                            <i class="fa fa-magic me-2"/>
                            تهيئة نظام العناية بالسيارات
                        </h1>

                        <div class="text-muted mt-2">
                            مرحباً بك 👋
                        </div>

                    </div>

                    <group>

                        <div class="alert alert-info">

                            هذه شاشة التهيئة الأولى للنظام

                        </div>

                    </group>

                </sheet>

            </form>

        </field>

    </record>

    <!-- =========================
            ACTION
    ========================== -->
 
    <record id="action_wof_setup_wizard" model="ir.actions.act_window">
        <field name="name">تهيئة النظام</field>
        <field name="res_model">wof.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>

    </record>


    <!-- =========================
            ACTION server
    ========================== -->
    <record id="action_open_setup_wizard" model="ir.actions.server">

        <field name="name">العناية بالسيارات</field>

        <field name="model_id" ref="model_wof_setup_wizard"/>

        <field name="state">code</field>

        <field name="code">
            action = model.action_open_setup_wizard()
                </field>

    </record>



</odoo>