<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wof_setup_activity_name_form" model="ir.ui.view">
        <field name="name">wof.setup.activity.line.name.form</field>
        <field name="model">wof.setup.activity.line</field>
        <field name="arch" type="xml">
            <form string="تعديل اسم النشاط" create="0" delete="0" class="wof_activity_name_dialog">
                <sheet>
                    <div class="wof_activity_name_edit" dir="rtl">
                        <h3>تعديل اسم النشاط</h3>
                        <p class="text-muted">يمكن تغيير الاسم الظاهر فقط، بينما يبقى نوع النشاط الداخلي ثابتًا.</p>
                        <group>
                            <field name="name" string="اسم النشاط"/>
                            <field name="activity_type" string="نوع النشاط" readonly="1"/>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wof_setup_activity_dialog_form" model="ir.ui.view">
        <field name="name">wof.setup.activity.dialog.form</field>
        <field name="model">wof.setup.activity.dialog</field>
        <field name="arch" type="xml">
            <form string="النشاط" create="0" delete="0" class="wof_activity_dialog_form">
                <sheet>
                    <field name="mode" invisible="1"/>
                    <field name="profile_id" invisible="1"/>
                    <field name="activity_line_id" invisible="1"/>
                    <div class="wof_activity_dialog_body" dir="rtl">
                        <div class="wof_activity_dialog_heading" invisible="mode != 'edit'">
                            <h3>تعديل النشاط</h3>
                            <p>عدّل الاسم أو الملاحظات، وسيبقى سلوك النشاط الداخلي كما هو.</p>
                        </div>
                        <div class="wof_activity_dialog_heading" invisible="mode != 'add'">
                            <h3>إضافة نشاط جديد</h3>
                            <p>أدخل اسمًا واضحًا للنشاط. الملاحظات اختيارية ولن ينشئ النظام وصفًا تلقائيًا.</p>
                        </div>
                        <div class="wof_activity_dialog_fields">
                            <div class="wof_activity_name_label" invisible="mode != 'add'">
                                <strong>اسم النشاط الجديد</strong>
                                <small>اكتب الاسم الذي تريد أن يظهر للمستخدمين في شاشة الأنشطة.</small>
                            </div>
                            <div class="wof_activity_name_label" invisible="mode != 'edit'">
                                <strong>اسم النشاط</strong>
                                <small>غيّر الاسم الظاهر للنشاط فقط، دون تغيير نوعه أو سلوكه الداخلي.</small>
                            </div>
                            <field name="name" class="wof_activity_name_input" placeholder="اكتب اسم النشاط..." required="1" nolabel="1"/>
                            <label for="description" string="ملاحظات"/>
                            <field name="description" placeholder="ملاحظات اختيارية..." nolabel="1"/>
                        </div>
                    </div>
                </sheet>
                <footer class="wof_activity_dialog_footer">
                    <button name="action_confirm" type="object" string="حفظ" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="إلغاء" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_wof_setup_size_dialog_form" model="ir.ui.view">
        <field name="name">wof.setup.size.dialog.form</field>
        <field name="model">wof.setup.size.dialog</field>
        <field name="arch" type="xml">
            <form string="حجم السيارة" create="0" delete="0" class="wof_activity_dialog_form wof_size_dialog_form">
                <sheet>
                    <field name="mode" invisible="1"/>
                    <field name="profile_id" invisible="1"/>
                    <field name="size_line_id" invisible="1"/>
                    <div class="wof_activity_dialog_body" dir="rtl">
                        <div class="wof_activity_dialog_heading" invisible="mode != 'edit'">
                            <h3>تعديل حجم السيارة</h3>
                            <p>غيّر الاسم الظاهر للحجم، وسيبقى الكود الداخلي ثابتًا لحماية الأسعار والبيانات المرتبطة.</p>
                        </div>
                        <div class="wof_activity_dialog_heading" invisible="mode != 'add'">
                            <h3>إضافة حجم سيارة جديد</h3>
                            <p>أدخل اسمًا واضحًا للحجم الذي تتعامل معه المنشأة.</p>
                        </div>
                        <div class="wof_activity_dialog_fields">
                            <div class="wof_activity_name_label" invisible="mode != 'add'">
                                <strong>اسم حجم السيارة الجديد</strong>
                                <small>مثال: بيك أب، فاخر، اقتصادي. سيظهر هذا الاسم لاحقًا في التسعير والخدمات.</small>
                            </div>
                            <div class="wof_activity_name_label" invisible="mode != 'edit'">
                                <strong>اسم حجم السيارة</strong>
                                <small>عدّل الاسم الظاهر فقط بدون تغيير هوية الحجم الداخلية.</small>
                            </div>
                            <field name="name" class="wof_activity_name_input" placeholder="اكتب اسم حجم السيارة..." required="1" nolabel="1"/>
                        </div>
                    </div>
                </sheet>
                <footer class="wof_activity_dialog_footer">
                    <button name="action_confirm" type="object" string="حفظ" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="إلغاء" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_wof_setup_wizard_form" model="ir.ui.view">
        <field name="name">wof.company.profile.setup.wizard.form</field>
        <field name="model">wof.company.profile</field>
        <field name="arch" type="xml">
            <form string="التهيئة الأولى" create="0" delete="0" class="wof_setup_form">
                <header invisible="current_step in ['activity', 'sizes', 'services']">
                    <button name="action_previous" type="object" string="السابق"
                            class="btn-secondary" invisible="current_step == 'activity'"/>
                    <button name="action_save" type="object" string="حفظ والمتابعة لاحقًا"
                            class="btn-secondary" invisible="state == 'ready'"/>
                    <button name="action_next" type="object" string="التالي"
                            class="btn-primary" invisible="current_step == 'review' or state == 'ready'"/>
                    <button name="action_activate" type="object" string="تفعيل النظام"
                            class="btn-primary" invisible="current_step != 'review' or state == 'ready'"/>
                    <button name="action_open_setup_center" type="object" string="فتح مركز الإعدادات"
                            class="btn-primary" invisible="state != 'ready'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,ready"/>
                </header>
                <sheet class="wof_setup_sheet">
                    <field name="current_step" invisible="1"/>
                    <field name="readiness_ok" invisible="1"/>

                    <div invisible="current_step in ['activity', 'sizes', 'services']">
                    <div class="wof_setup_hero">
                        <div>
                            <span class="wof_setup_badge">إعداد ذاتي</span>
                            <h1>تهيئة نظام العناية بالسيارات</h1>
                            <p>خمس خطوات واضحة، ويمكنك حفظ العمل والعودة إليه في أي وقت.</p>
                        </div>
                        <div class="wof_setup_progress">
                            <strong><field name="progress" widget="progressbar"/></strong>
                            <small>نسبة الاكتمال</small>
                        </div>
                    </div>

                    <div class="wof_setup_steps">
                        <span class="wof_setup_step" invisible="current_step == 'activity'">١. النشاط</span>
                        <span class="wof_setup_step active" invisible="current_step != 'activity'">١. النشاط</span>
                        <span class="wof_setup_step" invisible="current_step == 'sizes'">٢. الأحجام</span>
                        <span class="wof_setup_step active" invisible="current_step != 'sizes'">٢. الأحجام</span>
                        <span class="wof_setup_step" invisible="current_step == 'services'">٣. درجات اللون</span>
                        <span class="wof_setup_step active" invisible="current_step != 'services'">٣. درجات اللون</span>
                        <span class="wof_setup_step" invisible="current_step == 'operations'">٤. التشغيل</span>
                        <span class="wof_setup_step active" invisible="current_step != 'operations'">٤. التشغيل</span>
                        <span class="wof_setup_step" invisible="current_step == 'review'">٥. المراجعة</span>
                        <span class="wof_setup_step active" invisible="current_step != 'review'">٥. المراجعة</span>
                    </div>

                    </div>

                    <div invisible="current_step != 'activity'" class="wof_stage1_shell" dir="rtl">
                        <div class="wof_stage1_intro_panel">
                            <div class="wof_stage1_header">
                                <h1>مركز تهيئة النظام</h1>
                                <p>سنقوم بتهيئة النظام معك خطوة بخطوة ويمكن تعديل الإعدادات لاحقًا</p>
                            </div>

                            <div class="wof_stage1_stepper" aria-label="خطوات التهيئة">
                            <div class="wof_stage1_step is-current">
                                <span class="wof_stage1_step_no">1</span>
                                <strong>الأنشطة</strong>
                                <small>الخطوة 1 من 5</small>
                            </div>
                            <div class="wof_stage1_connector is-current"></div>
                            <div class="wof_stage1_step">
                                <span class="wof_stage1_step_no">2</span>
                                <strong>أحجام السيارات</strong>
                            </div>
                            <div class="wof_stage1_connector"></div>
                            <div class="wof_stage1_step">
                                <span class="wof_stage1_step_no">3</span>
                                <strong>درجات اللون</strong>
                            </div>
                            <div class="wof_stage1_connector"></div>
                            <div class="wof_stage1_step">
                                <span class="wof_stage1_step_no">4</span>
                                <strong>التشغيل</strong>
                            </div>
                            <div class="wof_stage1_connector"></div>
                            <div class="wof_stage1_step">
                                <span class="wof_stage1_step_no">5</span>
                                <strong>المراجعة والتفعيل</strong>
                            </div>
                            </div>
                        </div>

                        <div class="wof_stage1_body_panel">
                            <div class="wof_stage1_content">
                                <div class="wof_stage1_title_row">
                                    <div class="wof_stage1_title">
                                        <h2>اختر الأنشطة التي تعمل بها المنشأة</h2>
                                        <p>فعّل الأنشطة التي تريد استخدامها في النظام. يمكنك تفعيل نشاط واحد أو أكثر.</p>
                                    </div>
                                    <button name="action_add_general_activity" type="object" class="btn wof_stage1_add_activity">
                                        <i class="fa fa-plus" title="إضافة"/> إضافة نشاط جديد
                                    </button>
                                </div>

                            <field name="activity_line_ids" nolabel="1" mode="kanban" class="wof_stage1_activity_field">
                                <kanban create="0" delete="0" class="wof_stage1_activity_kanban">
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="selected"/>
                                    <field name="activity_type"/>
                                    <field name="is_system_default"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div t-attf-class="wof_stage1_activity_card #{record.selected.raw_value ? 'is-enabled' : 'is-disabled'}">
                                                <div class="wof_stage1_activity_top">
                                                    <div class="wof_stage1_activity_identity">
                                                        <span t-if="record.activity_type.raw_value == 'tint'" class="wof_stage1_activity_icon">♨</span>
                                                        <span t-else="" class="wof_stage1_activity_icon">◇</span>
                                                        <strong><field name="name"/></strong>
                                                        <button name="action_edit_name" type="object" class="wof_stage1_edit_btn" title="تعديل اسم النشاط" aria-label="تعديل اسم النشاط">
                                                            <i class="fa fa-pencil" title="تعديل"/>
                                                        </button>
                                                    </div>
                                                    <div class="wof_stage1_toggle">
                                                        <field name="selected" widget="boolean_toggle" nolabel="1"/>
                                                    </div>
                                                </div>
                                                <p t-if="record.description.raw_value" class="wof_stage1_activity_desc"><field name="description"/></p>
                                                <div t-else="" class="wof_stage1_activity_desc is-empty"></div>
                                                <div class="wof_stage1_activity_meta">
                                                    <span t-if="record.selected.raw_value" class="wof_stage1_status is-on"><i class="fa fa-check-circle" title="مفعّل"/> مفعّل</span>
                                                    <span t-else="" class="wof_stage1_status is-off"><i class="fa fa-circle" title="غير مفعّل"/> غير مفعّل</span>
                                                    <span t-if="record.activity_type.raw_value == 'tint'" class="wof_stage1_hint">يدعم درجات اللون</span>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>

                            </div>

                            <div class="wof_stage1_footer">
                            <p>يمكن تعديل الأنشطة لاحقًا من مركز التهيئة.</p>
                            <button name="action_next" type="object" class="btn btn-primary wof_stage1_next">
                                التالي: أحجام السيارات <i class="fa fa-arrow-left" title="التالي"/>
                            </button>
                            </div>
                        </div>
                    </div>

                    <div invisible="current_step != 'sizes'" class="wof_stage1_shell wof_stage2_shell" dir="rtl">
                        <div class="wof_stage1_intro_panel">
                            <div class="wof_stage1_header">
                                <h1>مركز تهيئة النظام</h1>
                                <p>سنقوم بتهيئة النظام معك خطوة بخطوة ويمكن تعديل الإعدادات لاحقًا</p>
                            </div>
                            <div class="wof_stage1_stepper" aria-label="خطوات التهيئة">
                                <div class="wof_stage1_step is-complete">
                                    <span class="wof_stage1_step_no"><i class="fa fa-check" title="مكتمل"/></span>
                                    <strong>الأنشطة</strong>
                                </div>
                                <div class="wof_stage1_connector is-current"></div>
                                <div class="wof_stage1_step is-current">
                                    <span class="wof_stage1_step_no">2</span>
                                    <strong>أحجام السيارات</strong>
                                    <small>الخطوة 2 من 5</small>
                                </div>
                                <div class="wof_stage1_connector"></div>
                                <div class="wof_stage1_step">
                                    <span class="wof_stage1_step_no">3</span>
                                    <strong>درجات اللون</strong>
                                </div>
                                <div class="wof_stage1_connector"></div>
                                <div class="wof_stage1_step">
                                    <span class="wof_stage1_step_no">4</span>
                                    <strong>التشغيل</strong>
                                </div>
                                <div class="wof_stage1_connector"></div>
                                <div class="wof_stage1_step">
                                    <span class="wof_stage1_step_no">5</span>
                                    <strong>المراجعة والتفعيل</strong>
                                </div>
                            </div>
                        </div>

                        <div class="wof_stage1_body_panel">
                            <div class="wof_stage1_content">
                                <div class="wof_stage1_title_row wof_stage2_title_row">
                                    <div class="wof_stage1_title">
                                        <h2>حدد أحجام السيارات التي تتعامل معها المنشأة</h2>
                                        <p>فعّل الأحجام المستخدمة في المركز. ستُستخدم افتراضيًا عند إعداد الأفلام والخدمات ويمكن تخصيصها لاحقًا لكل فيلم أو خدمة.</p>
                                    </div>
                                    <button name="action_add_car_size" type="object" class="btn wof_stage1_add_activity">
                                        <i class="fa fa-plus" title="إضافة"/> إضافة حجم سيارة
                                    </button>
                                </div>

                                <field name="size_line_ids" nolabel="1" mode="kanban" class="wof_stage2_size_field">
                                    <kanban create="0" delete="0" class="wof_stage2_size_kanban">
                                        <field name="sequence"/>
                                        <field name="selected"/>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="is_system_default"/>
                                        <templates>
                                            <t t-name="kanban-box">
                                                <div t-attf-class="wof_stage2_size_card #{record.selected.raw_value ? 'is-enabled' : 'is-disabled'}">
                                                    <div class="wof_stage2_size_top">
                                                        <div class="wof_stage2_size_identity">
                                                            <span class="wof_stage2_size_icon"><i class="fa fa-car" title="حجم سيارة"/></span>
                                                            <strong><field name="name"/></strong>
                                                            <button name="action_edit_size" type="object" class="wof_stage1_edit_btn" title="تعديل اسم الحجم" aria-label="تعديل اسم الحجم">
                                                                <i class="fa fa-pencil" title="تعديل"/>
                                                            </button>
                                                        </div>
                                                        <div class="wof_stage1_toggle">
                                                            <field name="selected" widget="boolean_toggle" nolabel="1"/>
                                                        </div>
                                                    </div>
                                                    <div class="wof_stage2_size_desc">
                                                        <span t-if="record.code.raw_value == 'SMALL'">سيارات صغيرة</span>
                                                        <span t-elif="record.code.raw_value == 'MEDIUM'">سيارات متوسطة</span>
                                                        <span t-elif="record.code.raw_value == 'LARGE'">سيارات كبيرة</span>
                                                        <span t-elif="record.code.raw_value == 'SUV'">دفع رباعي وكروس أوفر</span>
                                                        <span t-else="">حجم مخصص للمنشأة</span>
                                                    </div>
                                                    <div class="wof_stage1_activity_meta">
                                                        <span t-if="record.selected.raw_value" class="wof_stage1_status is-on"><i class="fa fa-check-circle" title="مفعّل"/> مفعّل</span>
                                                        <span t-else="" class="wof_stage1_status is-off"><i class="fa fa-circle" title="غير مفعّل"/> غير مفعّل</span>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                            </div>

                            <div class="wof_stage1_footer wof_stage2_footer">
                                <div class="wof_stage2_prev_wrap">
                                    <button name="action_previous" type="object" class="btn btn-secondary wof_stage2_prev">
                                        <i class="fa fa-arrow-right" title="السابق"/> السابق: الأنشطة
                                    </button>
                                    <p>يمكن تعديل أحجام السيارات لاحقًا من مركز التهيئة.</p>
                                </div>
                                <button name="action_next" type="object" class="btn btn-primary wof_stage1_next">
                                    التالي: درجات اللون <i class="fa fa-arrow-left" title="التالي"/>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div invisible="current_step != 'services'" class="wof_stage1_shell wof_stage3_shell" dir="rtl">
                        <field name="tint_numbering_method" invisible="1"/>
                        <field name="has_tint_activity" invisible="1"/>
                        <div class="wof_stage1_intro_panel">
                            <div class="wof_stage1_header">
                                <h1>مركز تهيئة النظام</h1>
                                <p>سنقوم بتهيئة النظام معك خطوة بخطوة ويمكن تعديل الإعدادات لاحقًا</p>
                            </div>
                            <div class="wof_stage1_stepper" aria-label="خطوات التهيئة">
                                <div class="wof_stage1_step is-complete">
                                    <span class="wof_stage1_step_no"><i class="fa fa-check" title="مكتمل"/></span>
                                    <strong>الأنشطة</strong>
                                </div>
                                <div class="wof_stage1_connector is-current"></div>
                                <div class="wof_stage1_step is-complete">
                                    <span class="wof_stage1_step_no"><i class="fa fa-check" title="مكتمل"/></span>
                                    <strong>أحجام السيارات</strong>
                                </div>
                                <div class="wof_stage1_connector is-current"></div>
                                <div class="wof_stage1_step is-current">
                                    <span class="wof_stage1_step_no">3</span>
                                    <strong>درجات اللون</strong>
                                    <small>الخطوة 3 من 5</small>
                                </div>
                                <div class="wof_stage1_connector"></div>
                                <div class="wof_stage1_step">
                                    <span class="wof_stage1_step_no">4</span>
                                    <strong>التشغيل</strong>
                                </div>
                                <div class="wof_stage1_connector"></div>
                                <div class="wof_stage1_step">
                                    <span class="wof_stage1_step_no">5</span>
                                    <strong>المراجعة والتفعيل</strong>
                                </div>
                            </div>
                        </div>

                        <div class="wof_stage1_body_panel">
                            <div class="wof_stage1_content wof_stage3_content">
                                <div class="wof_stage1_title_row wof_stage3_title_row">
                                    <div class="wof_stage1_title">
                                        <h2>حدد نظام درجات اللون المعتمد</h2>
                                        <p>اختر طريقة ترقيم درجات اللون المستخدمة في المنشأة، ثم حدد الدرجات التي تريد اعتمادها.</p>
                                    </div>
                                </div>

                                <div invisible="not has_tint_activity" class="wof_stage3_active_area">
                                    <div class="wof_stage3_method_grid">
                                        <div class="wof_stage3_method_card is-selected" invisible="tint_numbering_method != 'sequential'">
                                            <div class="wof_stage3_method_head">
                                                <span class="wof_stage3_method_check"><i class="fa fa-check" title="معتمد"/></span>
                                                <strong>ترقيم تسلسلي</strong>
                                            </div>
                                            <div class="wof_stage3_method_values">00 <span>•</span> 01 <span>•</span> 02 <span>•</span> 03 <span>•</span> 04</div>
                                        </div>
                                        <div class="wof_stage3_method_card" invisible="tint_numbering_method == 'sequential'">
                                            <div class="wof_stage3_method_head"><span class="wof_stage3_method_radio"></span><strong>ترقيم تسلسلي</strong></div>
                                            <div class="wof_stage3_method_values">00 <span>•</span> 01 <span>•</span> 02 <span>•</span> 03 <span>•</span> 04</div>
                                            <button name="action_set_tint_numbering_sequential" type="object" string="اختيار" class="btn wof_stage3_choose_btn"/>
                                        </div>

                                        <div class="wof_stage3_method_card is-selected" invisible="tint_numbering_method != 'percentage'">
                                            <div class="wof_stage3_method_head">
                                                <span class="wof_stage3_method_check"><i class="fa fa-check" title="معتمد"/></span>
                                                <strong>ترقيم بالنسب</strong>
                                            </div>
                                            <div class="wof_stage3_method_values">00 <span>•</span> 30 <span>•</span> 50 <span>•</span> 75 <span>•</span> 100</div>
                                        </div>
                                        <div class="wof_stage3_method_card" invisible="tint_numbering_method == 'percentage'">
                                            <div class="wof_stage3_method_head"><span class="wof_stage3_method_radio"></span><strong>ترقيم بالنسب</strong></div>
                                            <div class="wof_stage3_method_values">00 <span>•</span> 30 <span>•</span> 50 <span>•</span> 75 <span>•</span> 100</div>
                                            <button name="action_set_tint_numbering_percentage" type="object" string="اختيار" class="btn wof_stage3_choose_btn"/>
                                        </div>
                                    </div>

                                    <div class="wof_stage3_lock_note">
                                        <i class="fa fa-info-circle" title="معلومة"/>
                                        <span>بعد تفعيل النظام سيتم تثبيت طريقة الترقيم ولا يمكن تغييرها.</span>
                                    </div>

                                    <div class="wof_stage3_shades_header">
                                        <h3>درجات اللون المعتمدة</h3>
                                        <p>فعّل الدرجات التي تستخدمها المنشأة.</p>
                                    </div>

                                    <field name="tint_shade_line_ids" nolabel="1" mode="kanban" class="wof_stage3_shade_field">
                                        <kanban create="0" delete="0" class="wof_stage3_shade_kanban">
                                            <field name="sequence"/>
                                            <field name="selected"/>
                                            <field name="value"/>
                                            <templates>
                                                <t t-name="kanban-box">
                                                    <div t-attf-class="wof_stage3_shade_card #{record.selected.raw_value ? 'is-enabled' : 'is-disabled'}">
                                                        <strong><field name="value"/></strong>
                                                        <field name="selected" widget="boolean_toggle" nolabel="1"/>
                                                    </div>
                                                </t>
                                            </templates>
                                        </kanban>
                                    </field>
                                </div>

                                <div invisible="has_tint_activity" class="wof_stage3_not_required">
                                    <span class="wof_stage3_not_required_icon"><i class="fa fa-info-circle" title="معلومة"/></span>
                                    <div>
                                        <strong>درجات اللون غير مطلوبة حاليًا</strong>
                                        <p>لم يتم تفعيل نشاط عزل حراري. يمكنك المتابعة، وستبقى هذه الخطوة متاحة إذا فعّلت نشاط العزل لاحقًا.</p>
                                    </div>
                                </div>
                            </div>

                            <div class="wof_stage1_footer wof_stage2_footer wof_stage3_footer">
                                <div class="wof_stage2_prev_wrap">
                                    <button name="action_previous" type="object" class="btn btn-secondary wof_stage2_prev">
                                        <i class="fa fa-arrow-right" title="السابق"/> السابق: أحجام السيارات
                                    </button>
                                    <p>يمكن تعديل الدرجات المفعلة لاحقًا، أما طريقة الترقيم فتُثبت بعد تفعيل النظام.</p>
                                </div>
                                <button name="action_next" type="object" class="btn btn-primary wof_stage1_next">
                                    التالي: التشغيل <i class="fa fa-arrow-left" title="التالي"/>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div invisible="current_step != 'operations'">
                        <div class="wof_setup_section_title">
                            <h2>كيف يعمل المركز؟</h2>
                            <p>إعدادات بلغة العمل اليومية بدل خيارات تقنية متعارضة.</p>
                        </div>
                        <group col="2">
                            <group string="الدفع والفوترة">
                                <field name="payment_policy" widget="radio"/>
                                <field name="discount_scope" widget="radio"/>
                            </group>
                            <group string="التشغيل">
                                <field name="commission_event" widget="radio"/>
                                <field name="required_vehicle_data" widget="radio"/>
                                <field name="use_inventory"/>
                                <field name="use_appointments"/>
                            </group>
                        </group>
                        <details class="wof_setup_advanced">
                            <summary>خيارات متقدمة — يمكن تعديلها لاحقًا</summary>
                            <group>
                                <field name="advanced_pricing"/>
                                <field name="advanced_commission"/>
                            </group>
                        </details>
                    </div>

                    <div invisible="current_step != 'review'">
                        <div class="wof_setup_section_title">
                            <h2>مراجعة الجاهزية</h2>
                            <p>لن يفعّل النظام إلا بعد اكتمال الحد الأدنى المطلوب للتشغيل.</p>
                        </div>
                        <div class="alert alert-success" role="status"
                             invisible="not readiness_ok">
                            <strong>جاهز للتشغيل.</strong>
                            ستُنشأ الأنشطة والخدمات/الأفلام ومكوّناتها وأسعارها بصورة آمنة دون تكرار.
                        </div>
                        <div class="alert alert-warning" role="status"
                             invisible="readiness_ok">
                            <strong>توجد بيانات ناقصة:</strong>
                            <field name="readiness_note" nolabel="1"/>
                        </div>
                        <group col="2">
                            <group string="الملف">
                                <field name="company_id" readonly="1"/>
                                <field name="setup_version" readonly="1"/>
                            </group>
                            <group string="السياسة التشغيلية">
                                <field name="payment_policy" readonly="1"/>
                                <field name="discount_scope" readonly="1"/>
                                <field name="commission_event" readonly="1"/>
                            </group>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wof_setup_center_form" model="ir.ui.view">
        <field name="name">wof.company.profile.setup.center.form</field>
        <field name="model">wof.company.profile</field>
        <field name="arch" type="xml">
            <form string="مركز إعدادات العناية" create="0" delete="0" class="wof_setup_form">
                <header>
                    <button name="action_reopen_wizard" type="object"
                            string="إعادة فتح التهيئة الأولى" class="btn-secondary"
                            groups="yousentech_wo_v4.group_wo_settings"/>
                    <field name="state" widget="statusbar" statusbar_visible="ready"/>
                </header>
                <sheet class="wof_setup_sheet">
                    <div class="wof_setup_hero">
                        <div>
                            <span class="wof_setup_badge">مركز الإعدادات</span>
                            <h1>جاهزية نظام العناية</h1>
                            <p>تابع البيانات الأساسية وافتح التفاصيل المتقدمة عند الحاجة.</p>
                        </div>
                        <div class="wof_setup_progress">
                            <strong><field name="progress" widget="progressbar"/></strong>
                            <small><field name="company_id" readonly="1"/></small>
                        </div>
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_services" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="service_count" widget="statinfo" string="أنشطة المركز"/>
                        </button>
                        <button name="action_open_films" type="object" class="oe_stat_button" icon="fa-film">
                            <field name="film_count" widget="statinfo" string="الخدمات / الأفلام"/>
                        </button>
                        <button name="action_open_sizes" type="object" class="oe_stat_button" icon="fa-car">
                            <field name="size_count" widget="statinfo" string="أحجام السيارات"/>
                        </button>
                        <button name="action_open_prices" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="missing_price_count" widget="statinfo" string="أسعار تحتاج مراجعة"/>
                        </button>
                        <button name="action_open_commissions" type="object" class="oe_stat_button" icon="fa-users">
                            <div class="o_stat_info"><span class="o_stat_text">العمولات المتقدمة</span></div>
                        </button>
                    </div>

                    <notebook>
                        <page string="التشغيل والفوترة">
                            <group col="2">
                                <group>
                                    <field name="payment_policy"/>
                                    <field name="discount_scope"/>
                                    <field name="required_vehicle_data"/>
                                </group>
                                <group>
                                    <field name="commission_event"/>
                                    <field name="use_inventory"/>
                                    <field name="use_appointments"/>
                                </group>
                            </group>
                        </page>
                        <page string="خيارات متقدمة">
                            <group>
                                <field name="advanced_pricing"/>
                                <field name="advanced_commission"/>
                            </group>
                            <div class="alert alert-info" role="status">
                                تغيير هذه الخيارات لا يحذف البيانات السابقة. افتح التسعيرات أو العمولات لتعديل التفاصيل.
                            </div>
                        </page>
                        <page string="معلومات التهيئة">
                            <group>
                                <field name="company_id" readonly="1"/>
                                <field name="setup_version" readonly="1"/>
                                <field name="completed_at" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wof_setup_wizard" model="ir.actions.act_window">
        <field name="name">مركز تهيئة النظام</field>
        <field name="res_model">wof.company.profile</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wof_setup_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
