<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wof_setup_wizard_form" model="ir.ui.view">
        <field name="name">wof.company.profile.setup.wizard.form</field>
        <field name="model">wof.company.profile</field>
        <field name="arch" type="xml">
            <form string="التهيئة الأولى" create="0" delete="0" class="wof_setup_form">
                <header>
                    <button name="action_previous" type="object" string="السابق"
                            class="btn-secondary" invisible="current_step == 'activity'"/>
                    <button name="action_save" type="object" string="حفظ والمتابعة لاحقًا"
                            class="btn-secondary" invisible="state == 'ready'"/>
                    <button name="action_next" type="object" string="التالي"
                            class="btn-primary" invisible="current_step == 'review' or state == 'ready'"/>
                    <button name="action_activate" type="object" string="تفعيل النظام"
                            class="btn-primary" invisible="current_step != 'review' or state == 'ready'"/>
                    <button name="action_open_setup_center" type="object" string="فتح مركز الإعدادات"
                            class="btn-primary" invisible="state != 'ready'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,ready"/>
                </header>
                <sheet class="wof_setup_sheet">
                    <field name="current_step" invisible="1"/>
                    <field name="readiness_ok" invisible="1"/>

                    <div class="wof_setup_hero">
                        <div>
                            <span class="wof_setup_badge">إعداد ذاتي</span>
                            <h1>تهيئة نظام العناية بالسيارات</h1>
                            <p>خمس خطوات واضحة، ويمكنك حفظ العمل والعودة إليه في أي وقت.</p>
                        </div>
                        <div class="wof_setup_progress">
                            <strong><field name="progress" widget="progressbar"/></strong>
                            <small>نسبة الاكتمال</small>
                        </div>
                    </div>

                    <div class="wof_setup_steps">
                        <span class="wof_setup_step" invisible="current_step == 'activity'">١. النشاط</span>
                        <span class="wof_setup_step active" invisible="current_step != 'activity'">١. النشاط</span>
                        <span class="wof_setup_step" invisible="current_step == 'sizes'">٢. الأحجام</span>
                        <span class="wof_setup_step active" invisible="current_step != 'sizes'">٢. الأحجام</span>
                        <span class="wof_setup_step" invisible="current_step == 'services'">٣. الخدمات والأسعار</span>
                        <span class="wof_setup_step active" invisible="current_step != 'services'">٣. الخدمات والأسعار</span>
                        <span class="wof_setup_step" invisible="current_step == 'operations'">٤. التشغيل</span>
                        <span class="wof_setup_step active" invisible="current_step != 'operations'">٤. التشغيل</span>
                        <span class="wof_setup_step" invisible="current_step == 'review'">٥. المراجعة</span>
                        <span class="wof_setup_step active" invisible="current_step != 'review'">٥. المراجعة</span>
                    </div>

                    <div invisible="current_step != 'activity'">
                        <div class="wof_setup_section_title">
                            <h2>ما الخدمات التي يقدمها المركز؟</h2>
                            <p>اختر الموجود الآن فقط؛ سينشئ النظام خدمات وأجزاء جاهزة قابلة للتعديل.</p>
                        </div>
                        <group col="3" class="wof_setup_cards">
                            <group string="العزل الحراري">
                                <field name="activity_tint" widget="boolean_toggle" nolabel="1"/>
                                <div class="text-muted">الزجاج الأمامي والجانبي والخلفي</div>
                            </group>
                            <group string="حماية PPF">
                                <field name="activity_ppf" widget="boolean_toggle" nolabel="1"/>
                                <div class="text-muted">الصدام وغطاء المحرك والمرايا</div>
                            </group>
                            <group string="نانو سيراميك">
                                <field name="activity_nano" widget="boolean_toggle" nolabel="1"/>
                                <div class="text-muted">حماية الهيكل الخارجي</div>
                            </group>
                            <group string="التنجيد">
                                <field name="activity_upholstery" widget="boolean_toggle" nolabel="1"/>
                                <div class="text-muted">المقاعد والخامات الداخلية</div>
                            </group>
                            <group string="الأرضيات">
                                <field name="activity_floor_mats" widget="boolean_toggle" nolabel="1"/>
                                <div class="text-muted">أرضيات كاملة ومخصصة</div>
                            </group>
                            <group string="خدمات أخرى">
                                <field name="activity_others" widget="boolean_toggle" nolabel="1"/>
                                <div class="text-muted">قالب عام قابل لإعادة التسمية</div>
                            </group>
                        </group>
                    </div>

                    <div invisible="current_step != 'sizes'">
                        <div class="wof_setup_section_title">
                            <h2>أحجام السيارات</h2>
                            <p>جهزنا ثلاثة أحجام مناسبة كبداية. غيّر الاسم أو أضف حجمًا عند الحاجة.</p>
                        </div>
                        <field name="size_line_ids" nolabel="1">
                            <tree editable="bottom" delete="0">
                                <field name="sequence" widget="handle"/>
                                <field name="selected"/>
                                <field name="name"/>
                                <field name="code"/>
                            </tree>
                        </field>
                    </div>

                    <div invisible="current_step != 'services'">
                        <div class="wof_setup_section_title">
                            <h2>الخدمات والأسعار الأساسية</h2>
                            <p>أدخل سعرًا واحدًا كبداية. التفاصيل حسب الحجم والعمولة اختيارية ويمكن تعديلها لاحقًا.</p>
                        </div>
                        <field name="service_line_ids" nolabel="1">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="enabled"/>
                                <field name="service_kind" readonly="1"/>
                                <field name="name"/>
                                <field name="film_name"/>
                                <field name="base_price"/>
                                <field name="tax_id" options="{'no_create': True}"/>
                                <field name="company_id" column_invisible="1"/>
                                <field name="warranty_years"/>
                                <field name="default_commission" optional="hide"/>
                                <field name="inventory_enabled" optional="hide"/>
                            </tree>
                        </field>
                    </div>

                    <div invisible="current_step != 'operations'">
                        <div class="wof_setup_section_title">
                            <h2>كيف يعمل المركز؟</h2>
                            <p>إعدادات بلغة العمل اليومية بدل خيارات تقنية متعارضة.</p>
                        </div>
                        <group col="2">
                            <group string="الدفع والفوترة">
                                <field name="payment_policy" widget="radio"/>
                                <field name="discount_scope" widget="radio"/>
                            </group>
                            <group string="التشغيل">
                                <field name="commission_event" widget="radio"/>
                                <field name="required_vehicle_data" widget="radio"/>
                                <field name="use_inventory"/>
                                <field name="use_appointments"/>
                            </group>
                        </group>
                        <details class="wof_setup_advanced">
                            <summary>خيارات متقدمة — يمكن تعديلها لاحقًا</summary>
                            <group>
                                <field name="advanced_pricing"/>
                                <field name="advanced_commission"/>
                            </group>
                        </details>
                    </div>

                    <div invisible="current_step != 'review'">
                        <div class="wof_setup_section_title">
                            <h2>مراجعة الجاهزية</h2>
                            <p>لن يفعّل النظام إلا بعد اكتمال الحد الأدنى المطلوب للتشغيل.</p>
                        </div>
                        <div class="alert alert-success" role="status"
                             invisible="not readiness_ok">
                            <strong>جاهز للتشغيل.</strong>
                            ستُنشأ الخدمات والأفلام والأجزاء والأسعار بصورة آمنة دون تكرار.
                        </div>
                        <div class="alert alert-warning" role="status"
                             invisible="readiness_ok">
                            <strong>توجد بيانات ناقصة:</strong>
                            <field name="readiness_note" nolabel="1"/>
                        </div>
                        <group col="2">
                            <group string="الملف">
                                <field name="company_id" readonly="1"/>
                                <field name="setup_version" readonly="1"/>
                            </group>
                            <group string="السياسة التشغيلية">
                                <field name="payment_policy" readonly="1"/>
                                <field name="discount_scope" readonly="1"/>
                                <field name="commission_event" readonly="1"/>
                            </group>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_wof_setup_center_form" model="ir.ui.view">
        <field name="name">wof.company.profile.setup.center.form</field>
        <field name="model">wof.company.profile</field>
        <field name="arch" type="xml">
            <form string="مركز إعدادات العناية" create="0" delete="0" class="wof_setup_form">
                <header>
                    <button name="action_reopen_wizard" type="object"
                            string="إعادة فتح التهيئة الأولى" class="btn-secondary"
                            groups="yousentech_wo_v4.group_wo_settings"/>
                    <field name="state" widget="statusbar" statusbar_visible="ready"/>
                </header>
                <sheet class="wof_setup_sheet">
                    <div class="wof_setup_hero">
                        <div>
                            <span class="wof_setup_badge">مركز الإعدادات</span>
                            <h1>جاهزية نظام العناية</h1>
                            <p>تابع البيانات الأساسية وافتح التفاصيل المتقدمة عند الحاجة.</p>
                        </div>
                        <div class="wof_setup_progress">
                            <strong><field name="progress" widget="progressbar"/></strong>
                            <small><field name="company_id" readonly="1"/></small>
                        </div>
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_services" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="service_count" widget="statinfo" string="الخدمات"/>
                        </button>
                        <button name="action_open_films" type="object" class="oe_stat_button" icon="fa-film">
                            <field name="film_count" widget="statinfo" string="الأفلام"/>
                        </button>
                        <button name="action_open_sizes" type="object" class="oe_stat_button" icon="fa-car">
                            <field name="size_count" widget="statinfo" string="أحجام السيارات"/>
                        </button>
                        <button name="action_open_prices" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="missing_price_count" widget="statinfo" string="أسعار تحتاج مراجعة"/>
                        </button>
                        <button name="action_open_commissions" type="object" class="oe_stat_button" icon="fa-users">
                            <div class="o_stat_info"><span class="o_stat_text">العمولات المتقدمة</span></div>
                        </button>
                    </div>

                    <notebook>
                        <page string="التشغيل والفوترة">
                            <group col="2">
                                <group>
                                    <field name="payment_policy"/>
                                    <field name="discount_scope"/>
                                    <field name="required_vehicle_data"/>
                                </group>
                                <group>
                                    <field name="commission_event"/>
                                    <field name="use_inventory"/>
                                    <field name="use_appointments"/>
                                </group>
                            </group>
                        </page>
                        <page string="خيارات متقدمة">
                            <group>
                                <field name="advanced_pricing"/>
                                <field name="advanced_commission"/>
                            </group>
                            <div class="alert alert-info" role="status">
                                تغيير هذه الخيارات لا يحذف البيانات السابقة. افتح التسعيرات أو العمولات لتعديل التفاصيل.
                            </div>
                        </page>
                        <page string="معلومات التهيئة">
                            <group>
                                <field name="company_id" readonly="1"/>
                                <field name="setup_version" readonly="1"/>
                                <field name="completed_at" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wof_setup_wizard" model="ir.actions.act_window">
        <field name="name">التهيئة الأولى</field>
        <field name="res_model">wof.company.profile</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wof_setup_wizard_form"/>
        <field name="target">current</field>
    </record>
</odoo>
