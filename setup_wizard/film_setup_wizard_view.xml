<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wof_film_setup_wizard_form" model="ir.ui.view">
        <field name="name">wof.film.setup.wizard.form</field>
        <field name="model">wof.film.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="إضافة فيلم / خدمة جديدة" class="wof_film_setup_form" create="0" edit="1" delete="0">
                <field name="hub_id" invisible="1"/>
                <field name="profile_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="activity_id" invisible="1"/>
                <field name="film_id" invisible="1"/>
                <field name="mode" invisible="1"/>
                <field name="current_step" invisible="1"/>
                <field name="supports_color_grades" invisible="1"/>
                <field name="use_system_tax_policy" invisible="1"/>
                <field name="tax_enabled" invisible="1"/>
                <field name="tax_id" invisible="1"/>
                <field name="price_input_mode" invisible="1"/>
                <field name="system_tax_enabled" invisible="1"/>
                <field name="system_tax_id" invisible="1"/>
                <field name="system_price_input_mode" invisible="1"/>
                <field name="tax_price_included" invisible="1"/>
                <field name="system_commission_calculation_policy" invisible="1"/>
                <field name="system_inventory_enabled" invisible="1"/>
                <field name="system_tint_count" invisible="1"/>
                <field name="system_size_count" invisible="1"/>
                <field name="activity_film_count" invisible="1"/>
                <field name="activity_parts_count" invisible="1"/>
                <field name="tint_selection_mode" invisible="1"/>
                <field name="system_tint_numbering_method" invisible="1"/>
                <field name="selected_tint_count" invisible="1"/>
                <field name="tint_required" invisible="1"/>

                <div class="wof_film_setup_shell">
                    <div class="wof_film_setup_header">
                        <h1>إضافة فيلم / خدمة جديدة</h1>
                        <p>أدخل البيانات الأساسية أولاً، ثم أكمل درجات اللون والمكونات والأسعار في الخطوات التالية.</p>
                        <div class="wof_film_setup_activity_badge">
                            <span>النشاط:</span>
                            <strong><field name="activity_id" readonly="1" nolabel="1"/></strong>
                        </div>
                    </div>

                    <div class="wof_film_setup_steps">
                        <div class="wof_film_step is-active" invisible="current_step != 'basic'">
                            <span class="wof_film_step_no">1</span><strong>البيانات الأساسية</strong>
                        </div>
                        <div class="wof_film_step is-done" invisible="current_step == 'basic'">
                            <span class="wof_film_step_no"><i class="fa fa-check" title="مكتمل"/></span><strong>البيانات الأساسية</strong>
                        </div>
                        <div class="wof_film_step" invisible="current_step in ('tint', 'components', 'pricing', 'review')">
                            <span class="wof_film_step_no">2</span><strong>درجات اللون</strong>
                        </div>
                        <div class="wof_film_step is-active" invisible="current_step != 'tint'">
                            <span class="wof_film_step_no">2</span><strong>درجات اللون</strong>
                        </div>
                        <div class="wof_film_step is-done" invisible="current_step not in ('components', 'pricing', 'review')">
                            <span class="wof_film_step_no"><i class="fa fa-check" title="مكتمل"/></span><strong>درجات اللون</strong>
                        </div>
                        <div class="wof_film_step" invisible="current_step == 'components'">
                            <span class="wof_film_step_no">3</span><strong>المكونات</strong>
                        </div>
                        <div class="wof_film_step is-active" invisible="current_step != 'components'">
                            <span class="wof_film_step_no">3</span><strong>المكونات</strong>
                        </div>
                        <div class="wof_film_step">
                            <span class="wof_film_step_no">4</span><strong>الأسعار والعمولات</strong>
                        </div>
                        <div class="wof_film_step">
                            <span class="wof_film_step_no">5</span><strong>المراجعة والتفعيل</strong>
                        </div>
                    </div>

                    <div class="wof_film_setup_intro" invisible="current_step != 'basic'">
                        <i class="fa fa-magic" title="تهيئة"/>
                        أدخل البيانات الأساسية للفيلم أو الخدمة. يمكنك تعديل جميع الإعدادات قبل التفعيل.
                    </div>

                    <div class="wof_film_setup_body" invisible="current_step != 'basic'">
                        <div class="wof_film_setup_main">
                            <section class="wof_film_setup_card wof_film_basic_card">
                                <div class="wof_film_card_title">
                                    <span class="wof_film_card_icon"><i class="fa fa-file-text-o" title="البيانات الأساسية"/></span>
                                    <div>
                                        <h2>بيانات الفيلم / الخدمة</h2>
                                        <p>عرّف العنصر بشكل واضح ليظهر للمستخدمين بنفس الاسم والوصف.</p>
                                    </div>
                                </div>
                                <div class="wof_film_active_corner">
                                    <span invisible="not active">مفعّل</span>
                                    <span invisible="active">غير مفعّل</span>
                                    <field name="active" widget="boolean_toggle" nolabel="1"/>
                                </div>

                                <div class="wof_film_fields_grid">
                                    <div class="wof_film_field is-wide">
                                        <div class="o_form_label">اسم الفيلم / الخدمة <span class="wof_required">*</span></div>
                                        <field name="name" nolabel="1" required="1" placeholder="أدخل اسم الفيلم أو الخدمة"/>
                                    </div>
                                    <div class="wof_film_field">
                                        <div class="o_form_label">نوع العنصر <span class="wof_required">*</span></div>
                                        <field name="item_type" widget="radio" options="{'horizontal': True}" nolabel="1"/>
                                    </div>
                                    <div class="wof_film_field">
                                        <div class="o_form_label">الكود <span class="wof_optional">اختياري</span></div>
                                        <field name="code" nolabel="1" placeholder="يُنشأ تلقائياً إذا تُرك فارغاً"/>
                                    </div>
                                    <div class="wof_film_field">
                                        <div class="o_form_label">سنوات الضمان</div>
                                        <field name="warranty_years" nolabel="1"/>
                                        <small>القيمة الافتراضية التي تظهر في بيانات الفيلم أو الخدمة.</small>
                                    </div>
                                    <div class="wof_film_field is-full">
                                        <div class="o_form_label">الوصف المختصر <span class="wof_optional">اختياري</span></div>
                                        <field name="description" nolabel="1" placeholder="وصف مختصر يساعد المستخدم على معرفة الخدمة..."/>
                                    </div>
                                </div>
                            </section>

                            <section class="wof_film_compact_sections">
                                <details class="wof_compact_section" name="wof_film_policy_section">
                                    <summary>
                                        <span class="wof_compact_icon"><i class="fa fa-car" title="الأحجام والسيارة"/></span>
                                        <span class="wof_compact_copy"><strong>الأحجام والسيارة</strong><small>الأحجام المتاحة لهذا الفيلم / الخدمة</small></span>
                                        <span class="wof_compact_state"><i class="fa fa-check-circle" title="جاهز"/> يرث إعدادات النظام</span>
                                        <i class="fa fa-chevron-down wof_compact_arrow" title="توسيع"/>
                                    </summary>
                                    <div class="wof_compact_content">
                                        <div class="wof_system_value"><span>أحجام النظام المعتمدة</span><strong><field name="system_size_count" readonly="1" nolabel="1"/> أحجام</strong></div>
                                        <div class="wof_inline_toggle"><field name="use_system_car_sizes" widget="boolean_toggle" nolabel="1"/><span>استخدام جميع أحجام النظام</span></div>
                                        <div class="wof_size_chips"><field name="system_car_size_ids" widget="many2many_tags" readonly="1" nolabel="1" invisible="not use_system_car_sizes"/><field name="car_size_ids" widget="many2many_tags" nolabel="1" invisible="use_system_car_sizes"/></div>
                                    </div>
                                </details>

                                <details class="wof_compact_section" name="wof_film_policy_section">
                                    <summary>
                                        <span class="wof_compact_icon"><i class="fa fa-tag" title="التسعير"/></span>
                                        <span class="wof_compact_copy"><strong>التسعير</strong><small>حدد فقط سياسة التسعير الآن؛ القيم في خطوة الأسعار</small></span>
                                        <span class="wof_compact_state"><i class="fa fa-check-circle" title="جاهز"/> يرث إعدادات النظام</span>
                                        <i class="fa fa-chevron-down wof_compact_arrow" title="توسيع"/>
                                    </summary>
                                    <div class="wof_compact_content">
                                        <div class="wof_policy_heading"><i class="fa fa-tag" title="سياسة التسعير"/><div><strong>سياسة التسعير</strong><small>سعر موحد أو حسب حجم السيارة.</small></div></div>
                                        <div class="wof_system_value"><span>الافتراضي من النظام</span><field name="system_pricing_policy" readonly="1" nolabel="1"/></div>
                                        <div class="wof_inline_toggle"><field name="use_system_pricing_policy" widget="boolean_toggle" nolabel="1"/><span>استخدام سياسة النظام</span></div>
                                        <div class="wof_override_area" invisible="use_system_pricing_policy"><div class="o_form_label">تخصيص سياسة لهذا الفيلم / الخدمة</div><field name="pricing_policy" widget="radio" options="{'horizontal': True}" nolabel="1"/></div>
                                    </div>
                                </details>

                                <details class="wof_compact_section" name="wof_film_policy_section">
                                    <summary>
                                        <span class="wof_compact_icon"><i class="fa fa-percent" title="العمولة"/></span>
                                        <span class="wof_compact_copy"><strong>استحقاق العمولة</strong><small>وقت الاستحقاق وطريقة الاحتساب</small></span>
                                        <span class="wof_compact_state"><i class="fa fa-check-circle" title="جاهز"/> سياسة العمولة جاهزة</span>
                                        <i class="fa fa-chevron-down wof_compact_arrow" title="توسيع"/>
                                    </summary>
                                    <div class="wof_compact_content">
                                        <div class="wof_policy_split">
                                            <div>
                                                <div class="wof_policy_heading"><i class="fa fa-clock-o" title="استحقاق العمولة"/><div><strong>استحقاق العمولة</strong><small>متى تصبح عمولة الفني مستحقة؟</small></div></div>
                                                <div class="wof_system_value"><span>الافتراضي من النظام</span><field name="system_commission_event" readonly="1" nolabel="1"/></div>
                                                <div class="wof_inline_toggle"><field name="use_system_commission_policy" widget="boolean_toggle" nolabel="1"/><span>استخدام سياسة النظام</span></div>
                                                <div class="wof_override_area" invisible="use_system_commission_policy"><field name="commission_event" widget="radio" options="{'horizontal': True}" nolabel="1"/></div>
                                            </div>
                                            <div>
                                                <div class="wof_policy_heading"><i class="fa fa-calculator" title="احتساب العمولة"/><div><strong>طريقة احتساب العمولة</strong><small>تتبع سياسة النظام ما دام خيار استخدام سياسة النظام مفعّلًا.</small></div></div>
                                                <div class="wof_system_value" invisible="not use_system_commission_policy">
                                                    <span>حسب سياسة النظام</span>
                                                    <field name="system_commission_calculation_policy" readonly="1" nolabel="1"/>
                                                </div>
                                                <div class="wof_override_area" invisible="use_system_commission_policy">
                                                    <div class="o_form_label">تخصيص طريقة الاحتساب لهذا الفيلم / الخدمة</div>
                                                    <field name="commission_calculation_policy" widget="radio" options="{'horizontal': True}" nolabel="1"/>
                                                </div>
                                                <div class="wof_policy_help" invisible="use_system_commission_policy or commission_calculation_policy != 'by_size'"><i class="fa fa-info-circle" title="معلومة"/> في خطوة الأسعار والعمولات ستظهر أحجام السيارات ويُدخل مبلغ أو نسبة العمولة لكل حجم.</div>
                                            </div>
                                        </div>
                                    </div>
                                </details>

                                <details class="wof_compact_section" name="wof_film_policy_section">
                                    <summary>
                                        <span class="wof_compact_icon"><i class="fa fa-calculator" title="السياسات الضريبية"/></span>
                                        <span class="wof_compact_copy"><strong>السياسات الضريبية</strong><small>تطبيق الضريبة ونوعها وطريقة إدخال السعر</small></span>
                                        <span class="wof_compact_state" invisible="not use_system_tax_policy"><i class="fa fa-check-circle" title="موروث"/> يرث إعدادات النظام</span>
                                        <span class="wof_compact_state" invisible="use_system_tax_policy"><i class="fa fa-pencil" title="مخصص"/> سياسة مخصصة</span>
                                        <i class="fa fa-chevron-down wof_compact_arrow" title="توسيع"/>
                                    </summary>
                                    <div class="wof_compact_content">
                                        <div class="wof_policy_heading"><i class="fa fa-calculator" title="السياسات الضريبية"/><div><strong>السياسة الضريبية</strong><small>تأتي من مركز تهيئة النظام افتراضيًا، ويمكن تخصيصها لهذا الفيلم / الخدمة فقط.</small></div></div>
                                        <div class="wof_system_value">
                                            <span>سياسة النظام</span>
                                            <strong invisible="not system_tax_enabled">الضريبة مفعّلة</strong>
                                            <strong invisible="system_tax_enabled">الضريبة غير مفعّلة</strong>
                                            <field name="system_tax_id" readonly="1" nolabel="1" invisible="not system_tax_enabled"/>
                                            <field name="system_price_input_mode" readonly="1" nolabel="1" invisible="not system_tax_enabled"/>
                                        </div>
                                        <div class="wof_inline_toggle"><field name="use_system_tax_policy" widget="boolean_toggle" nolabel="1"/><span>استخدام سياسة النظام</span></div>
                                        <div class="wof_override_area" invisible="use_system_tax_policy">
                                            <div class="wof_tax_override_grid">
                                                <div class="wof_tax_override_item">
                                                    <div class="o_form_label">تطبيق الضريبة</div>
                                                    <div class="wof_inline_toggle"><field name="tax_enabled" widget="boolean_toggle" nolabel="1"/><span invisible="not tax_enabled">مفعّل</span><span invisible="tax_enabled">غير مفعّل</span></div>
                                                </div>
                                                <div class="wof_tax_override_item" invisible="not tax_enabled">
                                                    <div class="o_form_label">الضريبة المستخدمة</div>
                                                    <field name="tax_id" nolabel="1" options="{'no_create': True, 'no_create_edit': True}"/>
                                                </div>
                                                <div class="wof_tax_override_item" invisible="not tax_enabled">
                                                    <div class="o_form_label">طريقة إدخال السعر</div>
                                                    <div class="wof_system_value" invisible="not tax_price_included">
                                                        <i class="fa fa-lock" title="تحددها الضريبة"/>
                                                        <strong>السعر شامل الضريبة</strong>
                                                        <small>هذه الضريبة مضبوطة كشاملة للسعر، لذلك لا يمكن اختيار سعر قبل الضريبة.</small>
                                                    </div>
                                                    <field name="price_input_mode" widget="radio" options="{'horizontal': True}" nolabel="1" invisible="tax_price_included"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="wof_policy_help"><i class="fa fa-info-circle" title="معلومة"/> عند اختيار التخصيص تُحفظ هذه السياسة على مستوى الفيلم / الخدمة ولا تتأثر بتغييرات إعداد النظام لاحقًا.</div>
                                    </div>
                                </details>

                                <details class="wof_compact_section" name="wof_film_policy_section">
                                    <summary>
                                        <span class="wof_compact_icon"><i class="fa fa-cubes" title="المخزون والمنتج"/></span>
                                        <span class="wof_compact_copy"><strong>المخزون والمنتج</strong><small>إعدادات الصرف والمنتج المخزني والتنبيه</small></span>
                                        <span class="wof_compact_state"><i class="fa fa-check-circle" title="جاهز"/> وفق إعدادات النظام</span>
                                        <i class="fa fa-chevron-down wof_compact_arrow" title="توسيع"/>
                                    </summary>
                                    <div class="wof_compact_content">
                                        <div class="wof_policy_heading"><i class="fa fa-cube" title="المخزون"/><div><strong>المخزون</strong><small>حدد هل هذا العنصر يستهلك مواد فعلية من المخزون.</small></div></div>
                                        <div class="wof_system_value"><span>إعداد النظام</span><strong invisible="not system_inventory_enabled">صرف المخزون مفعّل</strong><strong invisible="system_inventory_enabled">صرف المخزون غير مفعّل</strong></div>
                                        <div class="wof_inventory_options"><div><field name="inventory_enabled" widget="boolean_toggle" nolabel="1"/><span>يصرف مواد من المخزون</span></div><div invisible="not inventory_enabled or item_type != 'film'"><field name="product_required" widget="boolean_toggle" nolabel="1"/><span>اختيار المنتج المخزني إلزامي</span></div></div>
                                        <div class="wof_film_optional_row"><div class="wof_film_field"><div class="o_form_label">رسالة تنبيه <span class="wof_optional">اختياري</span></div><field name="warning_msg" nolabel="1" placeholder="رسالة تظهر للمستخدم عند اختيار هذا الفيلم / الخدمة"/></div></div>
                                    </div>
                                </details>
                            </section>
                        </div>

                        <aside class="wof_film_setup_summary">
                            <div class="wof_summary_topline">
                                <span>النشاط</span>
                                <span class="wof_summary_status"><i class="fa fa-check-circle" title="مفعّل"/> مفعّل</span>
                            </div>
                            <div class="wof_summary_icon"><i class="fa fa-film" title="أفلام وخدمات"/></div>
                            <h2><field name="activity_id" readonly="1" nolabel="1"/></h2>
                            <p><field name="activity_description" readonly="1" nolabel="1"/></p>
                            <div class="wof_summary_stats">
                                <div><i class="fa fa-film" title="أفلام وخدمات"/><strong><field name="activity_film_count" readonly="1" nolabel="1"/></strong><span>أفلام / خدمات</span></div>
                                <div><i class="fa fa-car" title="أحجام السيارات"/><strong><field name="system_size_count" readonly="1" nolabel="1"/></strong><span>أحجام سيارات</span></div>
                                <div><i class="fa fa-tint" title="درجات اللون"/><strong><field name="system_tint_count" readonly="1" nolabel="1"/></strong><span>درجات لون</span></div>
                            </div>
                            <div class="wof_summary_policy">
                                <span>سياسة التسعير</span>
                                <strong><field name="system_pricing_policy" readonly="1" nolabel="1"/></strong>
                            </div>
                            <div class="wof_summary_note">
                                <i class="fa fa-info-circle" title="معلومة"/>
                                سيتم تطبيق إعدادات النشاط والنظام افتراضياً. يمكنك تخصيص أي سياسة من الكروت المجاورة.
                            </div>
                        </aside>
                    </div>

                    <div class="wof_film_tint_stage" invisible="current_step != 'tint'">
                        <div class="wof_film_setup_intro wof_tint_intro">
                            <i class="fa fa-info-circle" title="معلومة"/>
                            درجات اللون تستخدم فقط للأفلام التي تعتمد درجات اللون. اختر جميع درجات النظام أو حدد درجات خاصة بهذا الفيلم.
                        </div>

                        <div class="wof_film_setup_body wof_tint_body">
                            <div class="wof_film_setup_main">
                                <section class="wof_film_setup_card wof_tint_main_card">
                                    <div class="wof_film_card_title">
                                        <span class="wof_film_card_icon"><i class="fa fa-tint" title="درجات اللون"/></span>
                                        <div>
                                            <h2>درجات اللون</h2>
                                            <p>اختر درجات اللون المتاحة لهذا الفيلم من الدرجات المعتمدة في النظام.</p>
                                        </div>
                                        <span class="wof_tint_policy_badge" invisible="tint_selection_mode != 'all'"><i class="fa fa-check-circle" title="سياسة النظام"/> سياسة النظام</span>
                                        <span class="wof_tint_policy_badge is-custom" invisible="tint_selection_mode != 'specific'"><i class="fa fa-pencil" title="تخصيص"/> درجات مخصصة</span>
                                    </div>

                                    <div class="wof_tint_not_required" invisible="tint_required">
                                        <i class="fa fa-info-circle" title="غير مطلوب"/>
                                        <div>
                                            <strong>درجات اللون غير مطلوبة لهذا العنصر</strong>
                                            <p>نوع العنصر أو النشاط الحالي لا يحتاج درجات لون. يمكنك المتابعة مباشرة إلى المكونات.</p>
                                        </div>
                                    </div>

                                    <div class="wof_tint_required_area" invisible="not tint_required">
                                        <div class="wof_tint_mode_label">طريقة الاستخدام</div>
                                        <div class="wof_tint_mode_grid">
                                            <button name="action_use_all_tints" type="object" class="btn wof_tint_mode_card is-selected" invisible="tint_selection_mode != 'all'">
                                                <span class="wof_tint_mode_radio"><i class="fa fa-check" title="محدد"/></span>
                                                <strong>استخدام جميع درجات النظام</strong>
                                                <small>سيتم استخدام جميع درجات اللون المفعلة في إعدادات النظام.</small>
                                            </button>
                                            <button name="action_use_all_tints" type="object" class="btn wof_tint_mode_card" invisible="tint_selection_mode == 'all'">
                                                <span class="wof_tint_mode_radio"></span>
                                                <strong>استخدام جميع درجات النظام</strong>
                                                <small>سيتم استخدام جميع درجات اللون المفعلة في إعدادات النظام.</small>
                                            </button>
                                            <button name="action_use_specific_tints" type="object" class="btn wof_tint_mode_card is-selected" invisible="tint_selection_mode != 'specific'">
                                                <span class="wof_tint_mode_radio"><i class="fa fa-check" title="محدد"/></span>
                                                <strong>اختيار درجات محددة لهذا الفيلم</strong>
                                                <small>حدد فقط الدرجات التي تريد استخدامها في هذا الفيلم.</small>
                                            </button>
                                            <button name="action_use_specific_tints" type="object" class="btn wof_tint_mode_card" invisible="tint_selection_mode == 'specific'">
                                                <span class="wof_tint_mode_radio"></span>
                                                <strong>اختيار درجات محددة لهذا الفيلم</strong>
                                                <small>حدد فقط الدرجات التي تريد استخدامها في هذا الفيلم.</small>
                                            </button>
                                        </div>

                                        <div class="wof_tint_shades_panel">
                                            <div class="wof_tint_shades_header">
                                                <div>
                                                    <h3>درجات اللون</h3>
                                                    <p invisible="tint_selection_mode != 'specific'">اختر الدرجات التي تريد استخدامها لهذا الفيلم.</p>
                                                </div>
                                                <span class="wof_tint_selected_counter" invisible="tint_selection_mode != 'all'"><field name="system_tint_count" readonly="1" nolabel="1"/> درجات من النظام</span>
                                                <span class="wof_tint_selected_counter is-custom" invisible="tint_selection_mode != 'specific'"><field name="selected_tint_count" readonly="1" nolabel="1"/> مختارة</span>
                                            </div>
                                            <field name="tint_line_ids" nolabel="1" mode="kanban" class="wof_film_tint_line_field">
                                                <kanban create="0" delete="0" class="wof_film_tint_kanban">
                                                    <field name="sequence"/>
                                                    <field name="value"/>
                                                    <field name="selected"/>
                                                    <field name="locked"/>
                                                    <templates>
                                                        <t t-name="kanban-box">
                                                            <div t-attf-class="wof_film_tint_card #{record.selected.raw_value ? 'is-selected' : 'is-unselected'} #{record.locked.raw_value ? 'is-locked' : ''}">
                                                                <div class="wof_film_tint_card_label">درجة</div>
                                                                <strong><field name="value"/></strong>
                                                                <div class="wof_film_tint_locked_state" invisible="not locked">
                                                                    <i class="fa fa-check" title="مستخدمة من النظام"/>
                                                                </div>
                                                                <div class="wof_film_tint_inline_toggle" invisible="locked">
                                                                    <field name="selected" widget="boolean_toggle" nolabel="1"/>
                                                                    <span invisible="not selected">مفعّلة</span>
                                                                    <span invisible="selected">غير مفعّلة</span>
                                                                </div>
                                                            </div>
                                                        </t>
                                                    </templates>
                                                </kanban>
                                            </field>
                                        </div>
                                    </div>
                                </section>
                            </div>

                            <aside class="wof_film_setup_summary wof_tint_summary">
                                <div class="wof_summary_topline">
                                    <span>النشاط</span>
                                    <span class="wof_summary_status"><i class="fa fa-check-circle" title="مفعّل"/> مفعّل</span>
                                </div>
                                <div class="wof_summary_icon"><i class="fa fa-film" title="أفلام وخدمات"/></div>
                                <h2><field name="activity_id" readonly="1" nolabel="1"/></h2>
                                <p><field name="activity_description" readonly="1" nolabel="1"/></p>
                                <div class="wof_summary_stats">
                                    <div><i class="fa fa-film" title="أفلام وخدمات"/><strong><field name="activity_film_count" readonly="1" nolabel="1"/></strong><span>أفلام / خدمات</span></div>
                                    <div><i class="fa fa-car" title="أحجام السيارات"/><strong><field name="system_size_count" readonly="1" nolabel="1"/></strong><span>أحجام سيارات</span></div>
                                    <div><i class="fa fa-tint" title="درجات اللون"/><strong><field name="selected_tint_count" readonly="1" nolabel="1"/></strong><span>درجات لون</span></div>
                                </div>
                                <div class="wof_summary_policy">
                                    <span>سياسة التسعير</span>
                                    <strong><field name="pricing_policy" readonly="1" nolabel="1"/></strong>
                                </div>
                                <div class="wof_summary_policy">
                                    <span>طريقة درجات اللون</span>
                                    <strong><field name="tint_selection_mode" readonly="1" nolabel="1"/></strong>
                                </div>
                                <div class="wof_summary_note">
                                    <i class="fa fa-info-circle" title="معلومة"/>
                                    يمكنك تعديل درجات هذا الفيلم قبل التفعيل. درجات النظام الأساسية تبقى محفوظة في مركز التهيئة.
                                </div>
                            </aside>
                        </div>
                    </div>

                    <div class="wof_film_stage_handoff" invisible="current_step != 'components'">
                        <div class="wof_handoff_icon"><i class="fa fa-cubes" title="المكونات"/></div>
                        <h2>تم حفظ درجات اللون</h2>
                        <p>الخطوة التالية: تحديد مكونات الفيلم أو الخدمة ومناطق الخدمة.</p>
                        <div class="wof_handoff_badges">
                            <span><field name="name" readonly="1" nolabel="1"/></span>
                            <span><field name="selected_tint_count" readonly="1" nolabel="1"/> درجات لون</span>
                        </div>
                        <button name="action_back_tint" type="object" class="btn btn-secondary">السابق: درجات اللون</button>
                        <p class="wof_handoff_hint">سيتم إضافة واجهة المكونات المعتمدة في الخطوة التالية دون تغيير البيانات المحفوظة.</p>
                    </div>
                </div>

                <footer invisible="current_step != 'basic'" class="wof_film_setup_footer">
                    <button name="action_cancel" string="إلغاء" type="object" class="btn btn-secondary"/>
                    <div class="wof_film_footer_actions">
                        <button name="action_save_draft" string="حفظ كمسودة" type="object" class="btn btn-outline-primary"/>
                        <button name="action_continue" string="حفظ والمتابعة" type="object" class="btn btn-primary"/>
                    </div>
                </footer>
                <footer invisible="current_step != 'tint'" class="wof_film_setup_footer wof_tint_footer">
                    <button name="action_cancel" string="إلغاء" type="object" class="btn btn-secondary"/>
                    <div class="wof_film_footer_actions">
                        <button name="action_back_basic" string="السابق: البيانات الأساسية" type="object" class="btn btn-outline-primary"/>
                        <button name="action_continue_tint" string="التالي: المكونات" type="object" class="btn btn-primary"/>
                    </div>
                </footer>
                <footer invisible="current_step in ('basic', 'tint')" class="wof_film_setup_footer">
                    <button name="action_cancel" string="العودة إلى الأفلام والخدمات" type="object" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
