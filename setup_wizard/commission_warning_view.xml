<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wof_film_setup_commission_warning_form" model="ir.ui.view">
        <field name="name">wof.film.setup.commission.warning.form</field>
        <field name="model">wof.film.setup.commission.warning</field>
        <field name="arch" type="xml">
            <form string="تنبيه: العمولات غير مكتملة" create="0" edit="0" delete="0" class="wof_film_setup_form">
                <field name="wizard_id" invisible="1"/>
                <div class="alert alert-warning mb-3" role="alert">
                    <strong><i class="fa fa-exclamation-triangle" title="تنبيه"/> العمولات غير مكتملة</strong>
                    <div class="mt-1">بعض المكونات لم تُحدد عمولتها بعد. يمكنك العودة لإكمال البيانات، أو المتابعة إلى المراجعة والتفعيل مع إبقاء العمولات الناقصة غير مكتملة.</div>
                </div>
                <group>
                    <field name="missing_names" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_complete_commission" string="إكمال العمولات" type="object" class="btn btn-primary"/>
                    <button name="action_continue_review" string="المتابعة إلى المراجعة" type="object" class="btn btn-outline-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
