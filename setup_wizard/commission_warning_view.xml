<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wof_film_setup_commission_warning_form" model="ir.ui.view">
        <field name="name">wof.film.setup.commission.warning.form</field>
        <field name="model">wof.film.setup.commission.warning</field>
        <field name="arch" type="xml">
            <form string="تنبيه: العمولات غير مكتملة" create="0" edit="0" delete="0" class="wof_commission_warning_form">
                <field name="wizard_id" invisible="1"/>
                <div class="wof_commission_warning_content">
                    <div class="wof_commission_warning_heading">
                        <span class="wof_commission_warning_icon"><i class="fa fa-exclamation-triangle" title="تنبيه"/></span>
                        <div>
                            <h3>العمولات غير مكتملة</h3>
                            <p>بعض المكونات لم تُحدد عمولتها بعد. يمكنك إكمالها الآن أو المتابعة إلى المراجعة مع إبقاء العمولات الناقصة دون تغيير.</p>
                        </div>
                    </div>
                    <div class="wof_commission_warning_missing">
                        <strong>المكونات التي تحتاج إكمال العمولة</strong>
                        <field name="missing_names" nolabel="1" readonly="1" widget="text"/>
                    </div>
                </div>
                <footer>
                    <button name="action_complete_commission" string="إكمال العمولات" type="object" class="btn btn-secondary"/>
                    <button name="action_continue_review" string="المتابعة إلى المراجعة" type="object" class="btn btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
